{% render 'product-hotspot',
  product: block.settings.product,
  instance_id: block.id,
  x_position: block.settings.x-position,
  y_position: block.settings.y-position,
  hover_image: block.settings.hover_image,
  hotspot_color: section.settings.hotspot_color,
  bullseye_color: section.settings.bullseye_color,
  desktop_interaction_mode: section.settings.desktop_interaction_mode,
  quick_buy_hover_label: section.settings.quick_buy_hover_label,
  color_scheme: section.settings.color_scheme,
  product_title_preset: section.settings.product_title_preset,
  product_price_preset: section.settings.product_price_preset,
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:names.hotspot_product",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "image_picker",
      "id": "hover_image",
      "label": "t:settings.hover_image"
    },
    {
      "type": "range",
      "id": "x-position",
      "label": "t:settings.x_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    },
    {
      "type": "range",
      "id": "y-position",
      "label": "t:settings.y_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "t:names.hotspot_product"
    }
  ]
}
{% endschema %}
