{% capture items %}{% content_for 'blocks' %}{% endcapture %}
{% assign items = items | strip %}

{% if items != blank or request.design_mode %}
  <div
    class="am-pdp-benefits spacing-style{% unless block.settings.inherit_color_scheme %} color-{{ block.settings.color_scheme }}{% endunless %}"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {% if items != blank %}
      <ul class="am-pdp-benefits__list" role="list">{{ items }}</ul>
    {% else %}
      <p>{{ 'am_pdp.add_benefits' | t }}</p>
    {% endif %}
  </div>
{% endif %}

{% render 'am--benefits-styles' %}

{% schema %}
{
  "name": "t:am_pdp.shared_benefits",
  "tag": null,
  "blocks": [{ "type": "_am--benefit-item" }],
  "settings": [
    { "type": "checkbox", "id": "inherit_color_scheme", "label": "t:settings.inherit_color_scheme", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1", "visible_if": "{{ block.settings.inherit_color_scheme == false }}" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{
    "name": "t:am_pdp.shared_benefits",
    "category": "t:categories.product",
    "blocks": [
      { "type": "_am--benefit-item", "settings": { "icon": "return" } },
      { "type": "_am--benefit-item", "settings": { "icon": "truck" } },
      { "type": "_am--benefit-item", "settings": { "icon": "leaf" } }
    ]
  }]
}
{% endschema %}
