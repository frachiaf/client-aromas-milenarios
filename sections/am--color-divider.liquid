<div
  class="am--color-divider am--color-divider--{{ section.settings.separator_style }} color-{{ section.settings.color_scheme }}{% if section.settings.invert_colors %} am--is-inverted{% endif %}"
  style="--am-divider-height-desktop: {{ section.settings.height_desktop }}px; --am-divider-height-mobile: {{ section.settings.height_mobile }}px;"
>
  {%- if section.settings.separator_style == 'wave' -%}
    <svg
      class="am--color-divider__wave"
      viewBox="0 0 1440 200"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M0 112C210 2 402 18 650 108C878 191 1127 173 1440 96V200H0Z" />
    </svg>
  {%- endif -%}
</div>

{% stylesheet %}
  .am--shopify-section-color-divider {
    display: block;
    line-height: 0;
  }

  .am--color-divider {
    --am-divider-top-color: var(--color-background);
    --am-divider-bottom-color: var(--color-foreground);

    display: block;
    width: 100%;
    height: var(--am-divider-height-mobile);
    min-height: 0;
    padding: 0;
    margin: 0;
    overflow: hidden;
  }

  .am--color-divider.am--is-inverted {
    --am-divider-top-color: var(--color-foreground);
    --am-divider-bottom-color: var(--color-background);
  }

  .am--color-divider.am--color-divider--wave {
    background: var(--am-divider-top-color);
  }

  .am--color-divider__wave {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--am-divider-bottom-color);
  }

  .am--color-divider.am--color-divider--gradient {
    background: linear-gradient(
      180deg,
      var(--am-divider-top-color) 0%,
      var(--am-divider-bottom-color) 100%
    );
  }

  @media screen and (min-width: 750px) {
    .am--color-divider {
      height: var(--am-divider-height-desktop);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AM Divisor de color",
  "tag": "div",
  "class": "am--shopify-section-color-divider",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "separator_style",
      "label": "Estilo del divisor",
      "options": [
        {
          "value": "wave",
          "label": "Onda"
        },
        {
          "value": "gradient",
          "label": "Degradado"
        }
      ],
      "default": "wave"
    },
    {
      "type": "checkbox",
      "id": "invert_colors",
      "label": "Invertir colores",
      "default": false
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Altura (escritorio)",
      "min": 40,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Altura (móvil)",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "AM Divisor de color",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
