{{ 'am--hover-explorer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'am--hover-explorer.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_bg = section.settings.background_color | default: '#ffffff'
  assign content_bg = section.settings.content_background_color | default: '#ffffff'
  assign section_text_color = '#262a2b'
  assign content_text_color = '#262a2b'
  assign section_heading_color = section_text_color
  assign content_heading_color = content_text_color

  if section.settings.enable_color_scheme
    assign section_bg = 'var(--color-background)'
    assign content_bg = 'var(--color-background)'
    assign section_text_color = 'var(--color-foreground)'
    assign content_text_color = 'var(--color-foreground)'
    assign section_heading_color = 'var(--color-foreground-heading)'
    assign content_heading_color = 'var(--color-foreground-heading)'
  else
    assign section_brightness = section_bg | color_brightness
    assign content_brightness = content_bg | color_brightness
    if section_brightness < 128
      assign section_text_color = '#ffffff'
      assign section_heading_color = '#ffffff'
    endif
    if content_brightness < 128
      assign content_text_color = '#ffffff'
      assign content_heading_color = '#ffffff'
    endif
  endif
-%}

<am-hover-explorer
  class="am--hover-explorer{% if section.settings.enable_color_scheme %} color-{{ section.settings.color_scheme }}{% endif %}{% unless section.settings.show_mobile %} am--hide-mobile{% endunless %}{% unless section.settings.show_tablet %} am--hide-tablet{% endunless %}{% unless section.settings.show_desktop %} am--hide-desktop{% endunless %}"
  style="--am-background-color: {{ section_bg }}; --am-text-color: {{ section_text_color }}; --am-heading-color: {{ section_heading_color }}; --am-content-background-color: {{ content_bg }}; --am-content-text-color: {{ content_text_color }}; --am-content-heading-color: {{ content_heading_color }}; --am-padding-desktop-y: {{ section.settings.vertical_padding }}px; --am-padding-mobile-y: {{ section.settings.vertical_padding_mobile }}px; --am-padding-desktop-x: {{ section.settings.horizontal_padding }}px; --am-padding-mobile-x: {{ section.settings.horizontal_padding_mobile }}px; --am-title-spacing-desktop: {{ section.settings.title_spacing }}px; --am-title-spacing-mobile: {{ section.settings.title_spacing_mobile }}px;"
>
  <div class="am--hover-explorer__inner">
    {%- if section.settings.title != blank and section.settings.title_position == 'top_center' -%}
      <h2 class="am--hover-explorer__title am--hover-explorer__desktop-title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="am--hover-explorer__title am--hover-explorer__mobile-title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="am--hover-explorer__mobile">
      <ul class="am--hover-explorer__mobile-list">
        {%- for block in section.blocks -%}
          {%- assign mobile_active = false -%}
          {%- if forloop.first and section.settings.first_item_active -%}
            {%- assign mobile_active = true -%}
          {%- endif -%}
          <li
            class="am--hover-explorer__mobile-item{% if mobile_active %} am--is-active{% endif %}"
            data-am-mobile-item
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="am--hover-explorer__mobile-button"
              data-am-mobile-button
              aria-expanded="{{ mobile_active }}"
              aria-controls="am--hover-content-{{ section.id }}-{{ forloop.index0 }}"
            >
              <span>
                <span class="am--hover-explorer__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {{ block.settings.item_label | default: block.settings.title | escape }}
              </span>
              <svg class="am--hover-explorer__plus" aria-hidden="true" viewBox="0 0 47 47">
                <path fill="currentColor" d="M24 23V0h-1v23H0v1h23v23h1V24h23v-1H24Z"/>
              </svg>
            </button>
            <div
              id="am--hover-content-{{ section.id }}-{{ forloop.index0 }}"
              class="am--hover-explorer__mobile-content"
              data-am-mobile-content
              aria-hidden="{% if mobile_active %}false{% else %}true{% endif %}"
            >
              {%- if block.settings.image != blank -%}
                <div class="am--hover-explorer__mobile-media{% if section.settings.background_image == blank %} am--hover-explorer__mobile-media--single{% endif %}">
                  {%- if section.settings.background_image != blank -%}
                    <div class="am--hover-explorer__background-image">
                      {{ section.settings.background_image | image_url: width: 1200 | image_tag: widths: '375, 550, 750, 1000, 1200', sizes: '100vw', loading: 'lazy' }}
                    </div>
                    <div class="am--hover-explorer__foreground-image">
                      {{ block.settings.image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 750, 900', sizes: 'calc(100vw - 80px)', loading: 'lazy' }}
                    </div>
                  {%- else -%}
                    <div class="am--hover-explorer__single-image">
                      {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '375, 550, 750, 1000, 1200', sizes: '100vw', loading: 'lazy' }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div class="am--hover-explorer__mobile-copy">
                {%- if block.settings.subtitle != blank -%}
                  <h3 class="am--hover-explorer__eyebrow">{{ block.settings.subtitle | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="am--hover-explorer__description">{{ block.settings.description }}</div>
                {%- endif -%}
                {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                  <a
                    class="am--hover-explorer__link button"
                    href="{{ block.settings.button_link }}"
                    {% if section.settings.open_links_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                  >{{ block.settings.button_text | escape }}</a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="am--hover-explorer__desktop">
      <div class="am--hover-explorer__column am--hover-explorer__list-column">
        <div class="am--hover-explorer__list-wrapper">
          {%- if section.settings.title != blank and section.settings.title_position == 'top_left' -%}
            <h2 class="am--hover-explorer__title am--hover-explorer__list-title">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
          <ul class="am--hover-explorer__list">
            {%- for block in section.blocks -%}
              {%- assign desktop_active = false -%}
              {%- if forloop.first and section.settings.first_item_active -%}
                {%- assign desktop_active = true -%}
              {%- endif -%}
              <li class="am--hover-explorer__item{% if desktop_active %} am--is-active{% endif %}" data-am-desktop-item>
                <span class="am--hover-explorer__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <button
                  type="button"
                  class="am--hover-explorer__desktop-button{% if desktop_active %} am--is-active{% endif %}"
                  data-am-desktop-button
                  aria-pressed="{{ desktop_active }}"
                >{{ block.settings.item_label | default: block.settings.title | escape }}</button>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>

      <div class="am--hover-explorer__column am--hover-explorer__media-column">
        {%- if section.settings.background_image != blank -%}
          <div class="am--hover-explorer__media-background">
            {{ section.settings.background_image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '33vw', loading: 'lazy' }}
          </div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <div class="am--hover-explorer__media-item{% if forloop.first and section.settings.first_item_active %} am--is-active{% endif %}" data-am-media-item>
              {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '33vw', loading: 'lazy' }}
            </div>
          {%- else -%}
            <div class="am--hover-explorer__media-item{% if forloop.first and section.settings.first_item_active %} am--is-active{% endif %}" data-am-media-item></div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="am--hover-explorer__column am--hover-explorer__content-column">
        {%- if section.settings.title != blank and section.settings.title_position == 'top_right' -%}
          <h2 class="am--hover-explorer__title am--hover-explorer__content-title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        <div class="am--hover-explorer__content-stack">
          {%- for block in section.blocks -%}
            {%- assign content_active = false -%}
            {%- if forloop.first and section.settings.first_item_active -%}
              {%- assign content_active = true -%}
            {%- endif -%}
            <div
              class="am--hover-explorer__content-item{% if content_active %} am--is-active{% endif %}"
              data-am-content-item
              aria-hidden="{% if content_active %}false{% else %}true{% endif %}"
            >
              {%- if block.settings.subtitle != blank -%}
                <h3 class="am--hover-explorer__eyebrow">{{ block.settings.subtitle | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="am--hover-explorer__description">{{ block.settings.description }}</div>
              {%- endif -%}
              {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                <a
                  class="am--hover-explorer__link button"
                  href="{{ block.settings.button_link }}"
                  {% if section.settings.open_links_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                >{{ block.settings.button_text | escape }}</a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</am-hover-explorer>

{% schema %}
{
  "name": "AM Explorador interactivo",
  "tag": "section",
  "class": "am--shopify-section-hover-explorer",
  "settings": [
    { "type": "header", "content": "Visibilidad por dispositivo" },
    { "type": "checkbox", "id": "show_desktop", "label": "Mostrar en escritorio", "default": true },
    { "type": "checkbox", "id": "show_tablet", "label": "Mostrar en tablet", "default": true },
    { "type": "checkbox", "id": "show_mobile", "label": "Mostrar en móvil", "default": true },
    { "type": "text", "id": "title", "label": "Título de la sección", "default": "Know Your Glassware" },
    {
      "type": "select",
      "id": "title_position",
      "label": "Posición del título (escritorio)",
      "options": [
        { "value": "top_center", "label": "Parte superior centrada" },
        { "value": "top_left", "label": "Parte superior de la columna izquierda" },
        { "value": "top_right", "label": "Parte superior de la columna derecha" }
      ],
      "default": "top_center"
    },
    { "type": "range", "id": "title_spacing", "label": "Espacio inferior del título (escritorio)", "min": 0, "max": 100, "step": 5, "default": 40, "unit": "px" },
    { "type": "range", "id": "title_spacing_mobile", "label": "Espacio inferior del título (móvil)", "min": 0, "max": 60, "step": 5, "default": 30, "unit": "px" },
    { "type": "checkbox", "id": "first_item_active", "label": "Activar el primer elemento de forma predeterminada", "default": true },
    { "type": "checkbox", "id": "open_links_new_tab", "label": "Abrir enlaces en una pestaña nueva", "default": false },
    { "type": "checkbox", "id": "enable_color_scheme", "label": "Usar esquema de colores del tema", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.enable_color_scheme }}" },
    { "type": "color", "id": "background_color", "label": "Color de fondo de la sección", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "color", "id": "content_background_color", "label": "Color de fondo de la columna derecha", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "image_picker", "id": "background_image", "label": "Imagen de fondo", "info": "Imagen de fondo compartida detrás de las imágenes de todos los elementos." },
    { "type": "range", "id": "vertical_padding", "label": "Relleno vertical (escritorio)", "min": 0, "max": 100, "step": 5, "default": 60, "unit": "px" },
    { "type": "range", "id": "vertical_padding_mobile", "label": "Relleno vertical (móvil)", "min": 0, "max": 60, "step": 5, "default": 40, "unit": "px" },
    { "type": "range", "id": "horizontal_padding", "label": "Relleno horizontal (escritorio)", "min": 0, "max": 60, "step": 5, "default": 30, "unit": "px" },
    { "type": "range", "id": "horizontal_padding_mobile", "label": "Relleno horizontal (móvil)", "min": 0, "max": 40, "step": 5, "default": 20, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Elemento",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Item Title" },
        { "type": "text", "id": "item_label", "label": "Etiqueta de la lista", "info": "Si está vacío, usa el título.", "default": "CORDIAL GLASS" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "A SWEET SIP" },
        { "type": "richtext", "id": "description", "label": "Descripción", "default": "<p>For fine liqueurs and digestifs served in refined moderation.</p>" },
        { "type": "text", "id": "button_text", "label": "Texto del botón", "default": "SHOP CORDIAL GLASSES" },
        { "type": "url", "id": "button_link", "label": "Enlace del botón" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AM Explorador interactivo",
      "blocks": [
        { "type": "item", "settings": { "title": "Cordials", "item_label": "CORDIAL GLASS", "subtitle": "A SWEET SIP", "description": "<p>For fine liqueurs and digestifs served in refined moderation.</p>", "button_text": "SHOP CORDIAL GLASSES" } },
        { "type": "item", "settings": { "title": "Coupes", "item_label": "COUPE GLASS", "subtitle": "A SWEET SIP", "description": "<p>Description for coupe glass.</p>", "button_text": "SHOP COUPE GLASSES" } },
        { "type": "item", "settings": { "title": "Stirrup Cups", "item_label": "STIRRUP CUP", "subtitle": "A SWEET SIP", "description": "<p>Description for stirrup cup.</p>", "button_text": "SHOP STIRRUP CUPS" } }
      ]
    }
  ]
}
{% endschema %}
