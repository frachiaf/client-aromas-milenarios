{% liquid
  assign main_image = section.settings.image | default: section.settings.image_mobile
  assign review_count = 0
%}
{% capture review_slides %}
  {% for block in section.blocks %}
    {% assign review_text = block.settings.text | strip %}
    {% if review_text != blank or request.design_mode %}
      <slideshow-slide
        class="am-manual-reviews__slide color-{{ section.settings.card_color_scheme }}"
        ref="slides[]"
        slide-id="{{ block.id }}"
        aria-hidden="{% if review_count == 0 %}false{% else %}true{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="am-manual-reviews__stars" role="img" aria-label="{{ 'am_pdp.rating' | t: rating: block.settings.rating }}">
          {% for star in (1..5) %}
            <svg class="am-manual-reviews__star{% if star > block.settings.rating %} am-manual-reviews__star--empty{% endif %}" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="m10 1 2.78 5.63L19 7.54l-4.5 4.39L15.56 18 10 15.08 4.44 18l1.06-6.07L1 7.54l6.22-.91Z" />
            </svg>
          {% endfor %}
        </div>
        <blockquote class="am-manual-reviews__quote">
          {% if review_text != blank %}{{ review_text | escape | newline_to_br }}{% else %}{{ 'am_pdp.add_review_text' | t }}{% endif %}
        </blockquote>
        <div class="am-manual-reviews__author">
          {% if block.settings.author != blank or block.settings.detail != blank %}
            <p>
              {{ block.settings.author | escape }}{% if block.settings.author != blank and block.settings.detail != blank %} · {% endif %}{{ block.settings.detail | escape }}
            </p>
          {% endif %}
          {% if block.settings.verified and section.settings.verified_label != blank %}
            <span class="am-manual-reviews__verified">
              <span class="am-manual-reviews__check" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
              {{ section.settings.verified_label | escape }}
            </span>
          {% endif %}
        </div>
      </slideshow-slide>
      {% assign review_count = review_count | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endcapture %}

{% if review_count > 0 or request.design_mode %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div class="am-manual-reviews section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}" style="{% render 'spacing-style', settings: section.settings %}">
    <div class="am-manual-reviews__layout{% if main_image == blank and request.design_mode == false %} am-manual-reviews__layout--no-image{% endif %}">
      <div class="am-manual-reviews__content">
        {% if section.settings.heading != blank %}
          <h2 class="am-manual-reviews__heading h2">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if review_count > 0 %}
          {% if review_count > 1 %}
            {% capture controls %}
              <div class="am-manual-reviews__controls">
                {% render 'slideshow-arrow', action: 'previous', icon_style: 'chevron', icon_shape: 'circle' %}
                {% render 'slideshow-arrow', action: 'next', icon_style: 'chevron', icon_shape: 'circle' %}
              </div>
            {% endcapture %}
          {% endif %}
          {% render 'slideshow', class: 'am-manual-reviews__slideshow', slides: review_slides, controls: controls, slide_count: review_count, infinite: false, autoplay: false %}
        {% elsif request.design_mode %}
          <p>{{ 'am_pdp.add_reviews' | t }}</p>
        {% endif %}
      </div>
      {% if main_image != blank %}
        <picture class="am-manual-reviews__picture">
          {% if section.settings.image_mobile != blank %}
            <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 400 }} 400w, {{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw" width="{{ section.settings.image_mobile.width }}" height="{{ section.settings.image_mobile.height }}">
          {% endif %}
          {{ main_image | image_url: width: 1600 | image_tag: widths: '400, 750, 1100, 1600', sizes: '(min-width: 750px) 45vw, 100vw', loading: 'lazy' }}
        </picture>
      {% elsif request.design_mode %}
        <div class="am-manual-reviews__picture">{{ 'image' | placeholder_svg_tag: 'am-manual-reviews__placeholder' }}</div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .am-manual-reviews__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    min-width: 0;
  }

  .am-manual-reviews__content {
    min-width: 0;
    align-self: center;
  }

  .am-manual-reviews__heading {
    margin: 0 0 28px;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .am-manual-reviews__slideshow {
    --slideshow-gap: 20px;
    --slide-width: 88%;
  }

  .am-manual-reviews__slideshow slideshow-slides {
    align-items: stretch;
  }

  .am-manual-reviews__slide {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-height: 330px;
    max-height: none;
    padding: 28px;
    border-radius: 28px;
    scroll-snap-align: start;
    content-visibility: visible;
    overflow-wrap: anywhere;
    font-family: var(--font-paragraph--family);
    font-style: var(--font-paragraph--style);
    font-weight: var(--font-paragraph--weight);
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
  }

  .am-manual-reviews__stars {
    display: flex;
    gap: 2px;
    color: var(--color-primary);
  }

  .am-manual-reviews__star {
    width: 20px;
    height: 20px;
    fill: currentColor;
    flex-shrink: 0;
  }

  .am-manual-reviews__star--empty {
    fill: none;
    stroke: currentColor;
  }

  .am-manual-reviews__quote {
    margin: 0;
    padding: 0;
    border: 0;
    font: inherit;
    color: inherit;
  }

  .am-manual-reviews__author {
    display: grid;
    justify-items: start;
    gap: 10px;
    margin-block-start: auto;
    padding-block-start: 16px;
  }

  .am-manual-reviews__author p {
    margin: 0;
  }

  .am-manual-reviews__verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    max-width: 100%;
    padding: 4px 10px;
    border-radius: 4px;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    font-size: 0.875em;
  }

  .am-manual-reviews__check {
    display: inline-flex;
    flex: 0 0 16px;
  }

  .am-manual-reviews__check svg {
    width: 16px;
    height: 16px;
  }

  .am-manual-reviews__controls {
    display: flex;
    justify-content: center;
    gap: 18px;
    padding-block-start: 12px;
  }

  .am-manual-reviews__controls .slideshow-control {
    width: 48px;
    height: 48px;
    padding: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .am-manual-reviews__controls .slideshow-control:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .am-manual-reviews__picture {
    display: block;
    min-width: 0;
    overflow: hidden;
    border-radius: 28px;
  }

  .am-manual-reviews__picture img,
  .am-manual-reviews__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .am-manual-reviews__layout {
      grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
      gap: clamp(24px, 3vw, 48px);
    }

    .am-manual-reviews__layout--no-image {
      grid-template-columns: minmax(0, 1fr);
    }

    .am-manual-reviews__content {
      grid-column: 2;
      grid-row: 1;
    }

    .am-manual-reviews__layout--no-image .am-manual-reviews__content {
      grid-column: 1;
    }

    .am-manual-reviews__heading {
      text-align: start;
    }

    .am-manual-reviews__slideshow {
      --slide-width: 64%;
    }

    .am-manual-reviews__slide {
      padding: clamp(20px, 2vw, 32px);
    }

    .am-manual-reviews__controls {
      justify-content: flex-start;
    }

    .am-manual-reviews__picture {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:am_pdp.manual_reviews",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "t:am_pdp.reviews_heading" },
    { "type": "image_picker", "id": "image", "label": "t:settings.image" },
    { "type": "image_picker", "id": "image_mobile", "label": "t:am_pdp.mobile_image" },
    { "type": "text", "id": "verified_label", "label": "t:am_pdp.verified_label", "default": "t:am_pdp.verified_default" },
    { "type": "select", "id": "section_width", "label": "t:settings.width", "options": [{ "value": "page-width", "label": "t:options.page" }, { "value": "full-width", "label": "t:options.full" }], "default": "page-width" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "card_color_scheme", "label": "t:am_pdp.card_color_scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 48 }
  ],
  "blocks": [{
    "type": "review",
    "name": "t:am_pdp.review",
    "settings": [
      { "type": "textarea", "id": "text", "label": "t:settings.text" },
      { "type": "text", "id": "author", "label": "t:am_pdp.author" },
      { "type": "text", "id": "detail", "label": "t:am_pdp.author_detail" },
      { "type": "range", "id": "rating", "label": "t:am_pdp.rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "checkbox", "id": "verified", "label": "t:am_pdp.verified", "default": false }
    ]
  }],
  "max_blocks": 50,
  "presets": [{
    "name": "t:am_pdp.manual_reviews",
    "category": "t:categories.storytelling",
    "blocks": [
      { "type": "review", "settings": { "text": "t:am_pdp.example_review", "author": "t:am_pdp.example_author" } },
      { "type": "review", "settings": { "text": "t:am_pdp.example_review", "author": "t:am_pdp.example_author" } },
      { "type": "review", "settings": { "text": "t:am_pdp.example_review", "author": "t:am_pdp.example_author" } }
    ]
  }]
}
{% endschema %}
