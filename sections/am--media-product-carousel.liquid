{% liquid
  assign main_image = section.settings.image | default: section.settings.image_mobile
  assign item_count = section.blocks.size
  if section.settings.carousel_source == 'products'
    assign item_count = section.settings.products | size
    if item_count == 0 and request.design_mode
      assign item_count = 2
    endif
  endif

  assign show_arrows = false
  assign autoplay = false
  if item_count > 1
    assign show_arrows = section.settings.show_arrows
    assign autoplay = section.settings.autoplay
  endif

  assign poster_url = blank
  if section.settings.video_poster != blank
    assign poster_url = section.settings.video_poster | image_url: width: 1800
  elsif section.settings.video != blank and section.settings.video.preview_image != blank
    assign poster_url = section.settings.video.preview_image | image_url: width: 1800
  endif

  assign image_loading = 'lazy'
  assign image_fetch_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_fetch_priority = 'high'
  endif
%}

<am-media-product-carousel
  class="am-media-product-carousel section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}{% if section.settings.carousel_overlap > 0 %} am-media-product-carousel--overlap{% endif %}{% if section.settings.card_content_background_enabled %} am-media-product-carousel--card-background{% endif %}"
  style="--am-media-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --am-media-text-color: {{ section.settings.media_text_color }}; --am-carousel-gap: {{ section.settings.card_gap }}px; --am-carousel-overlap: {{ section.settings.carousel_overlap }}cqw; --am-card-height-desktop: {{ section.settings.card_height_desktop | times: 0.45 }}cqw; --am-card-height-mobile: {{ section.settings.card_height_mobile }}px; --am-card-content-padding: {{ section.settings.card_content_padding }}px; --am-card-content-background: {{ section.settings.card_content_background }}; --am-card-content-color: {{ section.settings.card_content_color }};"
>
  <div class="am-media-product-carousel__layout">
    <div class="am-media-product-carousel__media">
      {% if section.settings.media_type == 'video' and section.settings.video != blank %}
        {{
          section.settings.video
          | video_tag:
            autoplay: false,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            poster: poster_url,
            class: 'am-media-product-carousel__media-element'
        }}
        <button
          class="am-media-product-carousel__video-toggle"
          type="button"
          data-video-toggle
          aria-label="{{ 'accessibility.play_video' | t }}"
          aria-pressed="false"
          data-play-label="{{ 'accessibility.play_video' | t }}"
          data-pause-label="{{ 'accessibility.pause_video' | t }}"
        >
          <span class="am-media-product-carousel__play-icon" aria-hidden="true">{{ 'icon-play.svg' | inline_asset_content }}</span>
          <span class="am-media-product-carousel__pause-icon" aria-hidden="true">{{ 'icon-pause.svg' | inline_asset_content }}</span>
        </button>
      {% elsif main_image != blank %}
        <picture class="am-media-product-carousel__picture">
          {% if section.settings.image_mobile != blank %}
            <source
              media="(max-width: 1023px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 550 }} 550w, {{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
              sizes="100vw"
              width="{{ section.settings.image_mobile.width }}"
              height="{{ section.settings.image_mobile.height }}"
            >
          {% endif %}
          {{ main_image | image_url: width: 2400 | image_tag: widths: '550, 750, 1100, 1500, 1800, 2400', sizes: '(min-width: 1024px) 60vw, 100vw', loading: image_loading, fetchpriority: image_fetch_priority, class: 'am-media-product-carousel__media-element' }}
        </picture>
      {% elsif request.design_mode %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'am-media-product-carousel__placeholder' }}
      {% endif %}

      {% if section.settings.title != blank or section.settings.description != blank or section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
        <div class="am-media-product-carousel__overlay am-media-product-carousel__overlay--{{ section.settings.text_position }}">
          <div class="am-media-product-carousel__copy">
            {% if section.settings.title != blank %}
              <h2 class="am-media-product-carousel__title">{{ section.settings.title | escape }}</h2>
            {% endif %}
            {% if section.settings.description != blank %}
              <div class="am-media-product-carousel__description">{{ section.settings.description | escape | newline_to_br }}</div>
            {% endif %}
            {% if section.settings.button_1_label != blank and section.settings.button_1_link != blank or section.settings.button_2_label != blank and section.settings.button_2_link != blank %}
              <div class="am-media-product-carousel__buttons">
                {% if section.settings.button_1_label != blank and section.settings.button_1_link != blank %}
                  <a class="button" href="{{ section.settings.button_1_link }}">{{ section.settings.button_1_label | escape }}</a>
                {% endif %}
                {% if section.settings.button_2_label != blank and section.settings.button_2_link != blank %}
                  <a class="button-secondary" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_label | escape }}</a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="am-media-product-carousel__carousel-area">
      {% if section.settings.carousel_heading != blank %}
        <h2 class="am-media-product-carousel__carousel-heading">{{ section.settings.carousel_heading | escape }}</h2>
      {% else %}
        <h2 class="visually-hidden">{{ 'accessibility.slideshow' | t }}</h2>
      {% endif %}

      {% if item_count > 0 %}
        {% capture carousel_slides %}
          {% if section.settings.carousel_source == 'products' %}
            {% if section.settings.products == blank and request.design_mode %}
              {% for index in (1..2) %}
                <slideshow-slide class="am-media-product-carousel__slide am-media-product-carousel__product-slide" ref="slides[]" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                  {% # theme-check-disable UniqueStaticBlockId %}
                    {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
                  {% # theme-check-enable UniqueStaticBlockId %}
                </slideshow-slide>
              {% endfor %}
            {% else %}
              {% for product in section.settings.products %}
                <slideshow-slide class="am-media-product-carousel__slide am-media-product-carousel__product-slide" ref="slides[]" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                  {% # theme-check-disable UniqueStaticBlockId %}
                    {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
                  {% # theme-check-enable UniqueStaticBlockId %}
                </slideshow-slide>
              {% endfor %}
            {% endif %}
          {% else %}
            {% content_for 'blocks' %}
          {% endif %}
        {% endcapture %}

        {% if autoplay %}
          {% capture carousel_controls %}
            {% render 'slideshow-controls', style: 'counter', autoplay: true, item_count: item_count, show_arrows: false %}
          {% endcapture %}
        {% endif %}

        {% render 'slideshow',
          class: 'am-media-product-carousel__slideshow',
          slides: carousel_slides,
          controls: carousel_controls,
          slide_count: item_count,
          show_arrows: show_arrows,
          icon_style: 'chevron',
          icon_shape: section.settings.arrow_shape,
          infinite: section.settings.infinite,
          autoplay: autoplay,
          autoplay_speed: section.settings.autoplay_speed,
          auto_hide_controls: true
        %}
      {% endif %}
    </div>
  </div>
</am-media-product-carousel>

{% stylesheet %}
  .am-media-product-carousel__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .am-media-product-carousel__media {
    position: relative;
    min-width: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-background);
    color: var(--am-media-text-color);
  }

  .am-media-product-carousel__picture,
  .am-media-product-carousel__media-element,
  .am-media-product-carousel__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .am-media-product-carousel__media-element,
  .am-media-product-carousel__placeholder {
    object-fit: cover;
  }

  .am-media-product-carousel__media::after {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--am-media-overlay-opacity));
    content: '';
    pointer-events: none;
  }

  .am-media-product-carousel__overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(24px, 5vw, 72px);
    text-align: center;
    pointer-events: none;
  }

  .am-media-product-carousel__overlay--top { align-items: flex-start; }
  .am-media-product-carousel__overlay--bottom { align-items: flex-end; }
  .am-media-product-carousel__overlay--left { justify-content: flex-start; text-align: left; }
  .am-media-product-carousel__overlay--right { justify-content: flex-end; text-align: right; }

  .am-media-product-carousel__copy {
    max-width: 650px;
  }

  .am-media-product-carousel__title {
    margin: 0;
    color: inherit;
    font-family: var(--font-h2--family);
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.1;
  }

  .am-media-product-carousel__description {
    margin-top: 1rem;
    line-height: 1.5;
  }

  .am-media-product-carousel__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 1.5rem;
    pointer-events: auto;
  }

  .am-media-product-carousel__overlay--left .am-media-product-carousel__buttons { justify-content: flex-start; }
  .am-media-product-carousel__overlay--right .am-media-product-carousel__buttons { justify-content: flex-end; }

  .am-media-product-carousel__video-toggle {
    position: absolute;
    z-index: 2;
    inset-block-end: 16px;
    inset-inline-start: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--am-media-text-color);
    background: rgb(0 0 0 / 0.45);
    cursor: pointer;
  }

  .am-media-product-carousel__video-toggle svg { width: 18px; height: 18px; }
  .am-media-product-carousel__video-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  .am-media-product-carousel__video-toggle[aria-pressed='true'] .am-media-product-carousel__play-icon,
  .am-media-product-carousel__video-toggle[aria-pressed='false'] .am-media-product-carousel__pause-icon { display: none; }

  .am-media-product-carousel__carousel-area {
    --am-carousel-start-padding: clamp(16px, 3vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: clamp(24px, 4vw, 64px) 0 clamp(24px, 4vw, 64px) var(--am-carousel-start-padding);
    background: var(--color-background);
  }

  .am-media-product-carousel__carousel-heading {
    margin: 0 24px 20px 0;
  }

  .am-media-product-carousel__slideshow {
    min-width: 0;
    --am-card-height: var(--am-card-height-mobile);
    --slideshow-gap: var(--am-carousel-gap);
  }

  .am-media-product-carousel__slideshow > slideshow-container {
    min-width: 0;
    container-type: normal;
  }

  .am-media-product-carousel__slideshow > slideshow-container > slideshow-slides {
    padding-inline-end: 24px;
    scroll-padding-inline-start: 0;
    scroll-snap-type: x mandatory;
    align-items: center;
  }

  .am-media-product-carousel__slideshow > slideshow-container > slideshow-slides > .am-media-product-carousel__slide {
    flex: 0 0 calc((100% - var(--am-carousel-gap) - 24px) / 1.5);
    width: calc((100% - var(--am-carousel-gap) - 24px) / 1.5);
    height: auto;
    min-height: var(--am-card-height);
    min-width: 0;
    max-height: none;
    scroll-snap-align: start;
    content-visibility: visible;
  }

  .am-media-product-carousel__slideshow:has(> slideshow-container > slideshow-slides > .am-media-product-carousel__slide:only-child) > slideshow-container > slideshow-slides > .am-media-product-carousel__slide {
    flex-basis: calc(100% - 24px);
    width: calc(100% - 24px);
  }

  .am-media-product-carousel__product-slide product-card {
    display: block;
    width: 100%;
    min-height: var(--am-card-height);
  }

  .am-media-product-carousel__product-slide .product-card__content {
    display: grid;
    grid-template-rows: minmax(120px, 1fr);
    min-height: var(--am-card-height);
    height: auto;
    gap: 0;
    padding: 0;
  }

  .am-media-product-carousel__product-slide .product-card__content > .card-gallery {
    min-height: 120px;
    width: 100%;
    padding: 0;
    overflow: hidden;
  }

  .am-media-product-carousel__product-slide .card-gallery slideshow-component {
    --slideshow-gap: 0px;
  }

  .am-media-product-carousel__product-slide .card-gallery > a > slideshow-component,
  .am-media-product-carousel__product-slide .card-gallery > a > slideshow-component > slideshow-container,
  .am-media-product-carousel__product-slide .card-gallery > a > slideshow-component > slideshow-container > slideshow-slides,
  .am-media-product-carousel__product-slide .card-gallery .product-media-container,
  .am-media-product-carousel__product-slide .card-gallery .product-media {
    width: 100%;
    height: 100%;
    min-height: 0;
    aspect-ratio: auto;
  }

  .am-media-product-carousel__product-slide .card-gallery .product-media__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .am-media-product-carousel__product-slide .product-card__content > .card-gallery ~ * {
    padding: 4px var(--am-card-content-padding);
    background: transparent;
  }

  .am-media-product-carousel__product-slide .product-card__content > .card-gallery ~ a.contents {
    display: block;
  }

  .am-media-product-carousel__product-slide .product-card__content > .card-gallery + * {
    padding-block-start: var(--am-card-content-padding);
  }

  .am-media-product-carousel__product-slide .product-card__content > :last-child:not(.card-gallery) {
    padding-block-end: var(--am-card-content-padding);
  }

  .am-media-product-carousel--card-background .am-media-product-carousel__product-slide .product-card__content > .card-gallery ~ * {
    color: var(--am-card-content-color);
    background: var(--am-card-content-background);
    --color-foreground: var(--am-card-content-color);
  }

  .am-media-product-carousel__slideshow > slideshow-container > slideshow-arrows .slideshow-control {
    opacity: 1;
  }

  .am-media-product-carousel__slideshow > slideshow-controls {
    align-self: flex-end;
    margin: 12px 24px 0 0;
  }

  @media screen and (min-width: 1024px) {
    .am-media-product-carousel__layout {
      container-type: inline-size;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .am-media-product-carousel__media {
      aspect-ratio: 4 / 3;
    }

    .am-media-product-carousel__slideshow {
      --am-card-height: var(--am-card-height-desktop);
    }

    .am-media-product-carousel--overlap .am-media-product-carousel__carousel-area {
      position: relative;
      z-index: 2;
    }

    .am-media-product-carousel--overlap .am-media-product-carousel__slideshow {
      width: calc(100% + var(--am-carousel-overlap) + var(--am-carousel-start-padding));
      margin-inline-start: calc(0px - var(--am-carousel-overlap) - var(--am-carousel-start-padding));
    }

    .am-media-product-carousel--overlap .am-media-product-carousel__overlay {
      padding-inline-end: calc(clamp(24px, 5vw, 72px) + var(--am-carousel-overlap));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .am-media-product-carousel__slideshow > slideshow-container > slideshow-slides {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('am-media-product-carousel')) {
    class AmMediaProductCarousel extends HTMLElement {
      connectedCallback() {
        this.abortController = new AbortController();
        this.motion = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.carousel = this.querySelector('.am-media-product-carousel__slideshow');
        this.video = this.querySelector('video');
        this.toggle = this.querySelector('[data-video-toggle]');
        this.userPaused = false;

        const options = { signal: this.abortController.signal };
        this.motion.addEventListener('change', () => {
          this.updatePlayback();
          if (this.motion.matches) this.carousel?.pause?.();
        }, options);
        if (this.motion.matches && this.carousel?.hasAttribute('autoplay')) {
          customElements.whenDefined('slideshow-component').then(() => {
            if (this.isConnected && this.motion.matches) this.carousel?.pause?.();
          });
        }

        if (!this.video || !this.toggle) return;
        this.toggle.addEventListener('click', () => {
          if (this.video.paused) {
            this.userPaused = false;
            this.video.play().catch(() => {});
          } else {
            this.userPaused = true;
            this.video.pause();
          }
        }, options);
        this.video.addEventListener('play', () => this.updateToggle(), options);
        this.video.addEventListener('pause', () => this.updateToggle(), options);
        document.addEventListener('visibilitychange', () => this.updatePlayback(), options);
        this.updateToggle();
        this.updatePlayback();
      }

      disconnectedCallback() {
        this.abortController?.abort();
        this.video?.pause();
      }

      updatePlayback() {
        if (!this.video) return;
        if (document.hidden || this.motion.matches) {
          this.video.pause();
        } else if (!this.userPaused) {
          this.video.play().catch(() => {});
        }
      }

      updateToggle() {
        if (!this.video || !this.toggle) return;
        const playing = !this.video.paused;
        this.toggle.setAttribute('aria-pressed', String(playing));
        this.toggle.setAttribute('aria-label', this.toggle.dataset[playing ? 'pauseLabel' : 'playLabel']);
      }
    }

    customElements.define('am-media-product-carousel', AmMediaProductCarousel);
  }
{% endjavascript %}

{% schema %}
{
  "name": "AM Medio + Carrusel 60/40",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [{ "type": "am--media-carousel-card" }],
  "settings": [
    { "type": "header", "content": "Diseño" },
    { "type": "select", "id": "section_width", "label": "Ancho de la sección", "options": [{ "value": "full-width", "label": "Ancho completo" }, { "value": "page-width", "label": "Ancho de página" }], "default": "full-width" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "header", "content": "Medio principal" },
    { "type": "select", "id": "media_type", "label": "Tipo de medio", "options": [{ "value": "image", "label": "Imagen" }, { "value": "video", "label": "Video" }], "default": "image" },
    { "type": "image_picker", "id": "image", "label": "Imagen", "visible_if": "{{ section.settings.media_type == 'image' }}" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagen para móvil", "visible_if": "{{ section.settings.media_type == 'image' }}" },
    { "type": "video", "id": "video", "label": "Video de Shopify", "visible_if": "{{ section.settings.media_type == 'video' }}" },
    { "type": "image_picker", "id": "video_poster", "label": "Portada del video", "visible_if": "{{ section.settings.media_type == 'video' }}" },
    { "type": "range", "id": "overlay_opacity", "label": "Oscurecimiento del medio", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "color", "id": "media_text_color", "label": "Color del texto sobre el medio", "default": "#ffffff" },
    { "type": "header", "content": "Texto y botones del medio" },
    { "type": "text", "id": "title", "label": "Título" },
    { "type": "textarea", "id": "description", "label": "Descripción" },
    { "type": "select", "id": "text_position", "label": "Posición del texto", "options": [{ "value": "center", "label": "Centro" }, { "value": "top", "label": "Arriba" }, { "value": "bottom", "label": "Abajo" }, { "value": "left", "label": "Izquierda" }, { "value": "right", "label": "Derecha" }], "default": "center" },
    { "type": "text", "id": "button_1_label", "label": "Texto del botón principal" },
    { "type": "url", "id": "button_1_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "button_2_label", "label": "Texto del botón secundario" },
    { "type": "url", "id": "button_2_link", "label": "Enlace del botón secundario" },
    { "type": "header", "content": "Carrusel" },
    { "type": "select", "id": "carousel_source", "label": "Fuente de las cards", "options": [{ "value": "blocks", "label": "Bloques editoriales" }, { "value": "products", "label": "Productos elegidos" }], "default": "blocks" },
    { "type": "text", "id": "carousel_heading", "label": "Título del carrusel" },
    { "type": "product_list", "id": "products", "label": "Productos", "limit": 12, "info": "Se usan cuando la fuente es Productos elegidos." },
    { "type": "range", "id": "card_gap", "label": "Separación entre cards", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_height_desktop", "label": "Altura de cards en escritorio", "min": 50, "max": 90, "step": 5, "unit": "%", "default": 75, "info": "Porcentaje de la altura del medio principal desde 1024 px." },
    { "type": "range", "id": "card_height_mobile", "label": "Altura de cards en móvil y tablet", "min": 260, "max": 520, "step": 10, "unit": "px", "default": 360 },
    { "type": "range", "id": "card_content_padding", "label": "Padding del contenido de cards", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "card_content_background_enabled", "label": "Fondo en el contenido de cards", "default": false },
    { "type": "color", "id": "card_content_background", "label": "Color de fondo del contenido", "default": "#ffffff", "visible_if": "{{ section.settings.card_content_background_enabled }}" },
    { "type": "color", "id": "card_content_color", "label": "Color del texto del contenido", "default": "#1b1b1b", "visible_if": "{{ section.settings.card_content_background_enabled }}" },
    { "type": "range", "id": "carousel_overlap", "label": "Solapamiento del carrusel", "min": 0, "max": 15, "step": 1, "unit": "%", "default": 8, "info": "Porcentaje del ancho de la sección; solo en escritorio." },
    { "type": "checkbox", "id": "show_arrows", "label": "Mostrar flechas chevron", "default": true },
    { "type": "select", "id": "arrow_shape", "label": "Fondo de las flechas", "options": [{ "value": "none", "label": "Sin fondo" }, { "value": "circle", "label": "Círculo" }, { "value": "square", "label": "Cuadrado" }], "default": "circle", "visible_if": "{{ section.settings.show_arrows }}" },
