{{ 'am--numbered-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'am--numbered-slideshow.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign progress_color = section.settings.progress_color | default: '#262a2b'
  assign progress_muted = progress_color | color_modify: 'alpha', 0.4
  assign background_color = section.settings.background_color | default: 'transparent'
  assign text_color = section.settings.text_color | default: 'inherit'
  assign heading_color = text_color
  assign link_color = text_color

  if section.settings.enable_color_scheme
    assign progress_color = 'var(--color-primary)'
    assign progress_muted = 'var(--color-border)'
    assign background_color = 'var(--color-background)'
    assign text_color = 'var(--color-foreground)'
    assign heading_color = 'var(--color-foreground-heading)'
    assign link_color = 'var(--color-primary)'
  endif

  assign slider_items = section.blocks | where: 'type', 'slide'
-%}

<am-numbered-slideshow
  class="am--numbered-slideshow{% if section.settings.enable_color_scheme %} color-{{ section.settings.color_scheme }}{% endif %}{% unless section.settings.show_mobile %} am--hide-mobile{% endunless %}{% unless section.settings.show_tablet %} am--hide-tablet{% endunless %}{% unless section.settings.show_desktop %} am--hide-desktop{% endunless %}"
  style="--am-background-color: {{ background_color }}; --am-text-color: {{ text_color }}; --am-heading-color: {{ heading_color }}; --am-link-color: {{ link_color }}; --am-padding-y: {{ section.settings.vertical_padding }}px; --am-progress-color: {{ progress_color }}; --am-progress-muted: {{ progress_muted }};{% if section.settings.background_image != blank %} --am-background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');{% endif %}{% if section.settings.background_image_mobile != blank %} --am-background-image-mobile: url('{{ section.settings.background_image_mobile | image_url: width: 1200 }}');{% endif %}"
  data-am-autoplay="{{ section.settings.autoplay }}"
  data-am-loop="{{ section.settings.loop }}"
  data-am-interval="{{ section.settings.autoplay_slide_duration | times: 1000 }}"
>
  <div class="am--numbered-slideshow__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="am--numbered-slideshow__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="am--numbered-slideshow__viewport" aria-roledescription="carousel" aria-label="Slideshow">
      <ul class="am--numbered-slideshow__list">
        {%- for block in slider_items -%}
          <li
            id="am--numbered-slide-{{ section.id }}-{{ forloop.index0 }}"
            class="am--numbered-slideshow__slide{% if forloop.first %} am--is-active{% endif %}"
            data-am-slide
            role="tabpanel"
            aria-labelledby="am--numbered-control-{{ section.id }}-{{ forloop.index0 }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            aria-label="{{ forloop.index }} of {{ forloop.length }}"
            {{ block.shopify_attributes }}
          >
            <div class="am--numbered-slideshow__image {{ section.settings.image_aspect_ratio_mobile }}">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '375, 550, 750, 1100, 1500, 2000, 2400', sizes: '(min-width: 1440px) 1380px, (min-width: 1024px) calc(100vw - 60px), calc(100vw - 40px)', loading: 'lazy' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'am--numbered-slideshow__placeholder' }}
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if slider_items.size > 0 -%}
      <div class="am--numbered-slideshow__info">
        <div class="am--numbered-slideshow__tabs">
          <ul class="am--numbered-slideshow__numbers" role="tablist" aria-label="Select a slide to show">
            {%- for block in slider_items -%}
              <li role="presentation">
                <button
                  id="am--numbered-control-{{ section.id }}-{{ forloop.index0 }}"
                  type="button"
                  class="am--numbered-slideshow__control{% if forloop.first %} am--is-active{% endif %}"
                  data-am-control
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="am--numbered-slide-{{ section.id }}-{{ forloop.index0 }}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                >{{ forloop.index }}</button>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- if section.settings.autoplay -%}
          <div class="am--numbered-slideshow__progress-track" aria-hidden="true">
            <div class="am--numbered-slideshow__progress" data-am-progress></div>
          </div>
        {%- endif -%}

        <div class="am--numbered-slideshow__captions">
          {%- for block in slider_items -%}
            <div
              class="am--numbered-slideshow__caption{% if forloop.first %} am--is-active{% endif %}"
              data-am-caption
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            >
              {%- if block.settings.title != blank -%}
                <h3 class="am--numbered-slideshow__caption-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.link_title != blank and block.settings.url != blank -%}
                <a class="am--numbered-slideshow__caption-link" href="{{ block.settings.url }}">{{ block.settings.link_title | escape }}</a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- assign illustrations = section.blocks | where: 'type', 'illustration' -%}
  {%- for block in illustrations -%}
    {%- if block.settings.image != blank -%}
      <div
        class="am--numbered-slideshow__illustration {{ block.settings.horizontal_pos }} {{ block.settings.horizontal_pos_mobile }} {{ block.settings.vertical_pos }} {{ block.settings.vertical_pos_mobile }}{% if block.settings.image_mobile != blank %} am--has-mobile-image{% endif %}{% if block.settings.zindex %} am--position-front{% endif %}"
        style="--am-reposition-desktop: {{ block.settings.horizontal_reposition }}%; --am-reposition-mobile: {{ block.settings.horizontal_reposition_mobile }}%; --am-illustration-width-desktop: {{ block.settings.image.width }}px; --am-illustration-height-desktop: {{ block.settings.image.height }}px;{% if block.settings.image_mobile != blank %} --am-illustration-width-mobile: {{ block.settings.image_mobile.width }}px; --am-illustration-height-mobile: {{ block.settings.image_mobile.height }}px;{% else %} --am-illustration-width-mobile: {{ block.settings.image.width }}px; --am-illustration-height-mobile: {{ block.settings.image.height }}px;{% endif %}"
        data-am-illustration
        {{ block.shopify_attributes }}
      >
        {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', class: 'am--numbered-slideshow__illustration-desktop' }}
        {%- if block.settings.image_mobile != blank -%}
          {{ block.settings.image_mobile | image_url: width: block.settings.image_mobile.width | image_tag: loading: 'lazy', class: 'am--numbered-slideshow__illustration-mobile' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
</am-numbered-slideshow>

{% schema %}
{
  "name": "AM Numbered Slideshow",
  "tag": "section",
  "class": "am--shopify-section-numbered-slideshow",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Section title" },
    { "type": "header", "content": "Section settings" },
    { "type": "checkbox", "id": "show_desktop", "label": "Show desktop", "default": true },
    { "type": "checkbox", "id": "show_tablet", "label": "Show tablet", "default": true },
    { "type": "checkbox", "id": "show_mobile", "label": "Show mobile", "default": true },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 60 },
    { "type": "checkbox", "id": "enable_color_scheme", "label": "Use theme color scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.enable_color_scheme }}" },
    { "type": "color", "id": "background_color", "label": "Background color", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "color", "id": "text_color", "label": "Text color", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "header", "content": "Slideshow settings" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": true },
    { "type": "range", "id": "autoplay_slide_duration", "label": "Autoplay slide duration", "min": 3, "max": 8, "step": 1, "default": 8, "unit": "s" },
    { "type": "color", "id": "progress_color", "label": "Progress color", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "header", "content": "Image settings" },
    { "type": "image_picker", "id": "background_image", "label": "Background image (desktop)" },
    { "type": "image_picker", "id": "background_image_mobile", "label": "Background image (mobile)", "info": "Uses the desktop image when empty." },
    {
      "type": "select",
      "id": "image_aspect_ratio_mobile",
      "label": "Image aspect ratio (mobile)",
      "options": [
        { "value": "am--numbered-slideshow__image--4x3", "label": "4:3" },
        { "value": "am--numbered-slideshow__image--3x4", "label": "3:4" },
        { "value": "am--numbered-slideshow__image--1x1", "label": "1:1" },
        { "value": "am--numbered-slideshow__image--auto", "label": "Auto" }
      ],
      "default": "am--numbered-slideshow__image--auto"
    }
  ],
  "blocks": [
    {
      "name": "Slider item",
      "type": "slide",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "link_title", "label": "Link text" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "name": "Illustration",
      "type": "illustration",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)" },
        {
          "type": "select", "id": "horizontal_pos", "label": "Horizontal position (desktop)",
          "options": [
            { "value": "am--position-right", "label": "Right" },
            { "value": "am--position-center", "label": "Center" },
            { "value": "am--position-left", "label": "Left" }
          ], "default": "am--position-right"
        },
        {
          "type": "select", "id": "horizontal_pos_mobile", "label": "Horizontal position (mobile)",
          "options": [
            { "value": "am--position-right-mobile", "label": "Right" },
            { "value": "am--position-center-mobile", "label": "Center" },
            { "value": "am--position-left-mobile", "label": "Left" }
          ], "default": "am--position-right-mobile"
        },
        {
          "type": "select", "id": "vertical_pos", "label": "Vertical position (desktop)",
          "options": [
            { "value": "am--position-top", "label": "Top" },
            { "value": "am--position-middle", "label": "Middle" },
            { "value": "am--position-bottom", "label": "Bottom" }
          ], "default": "am--position-top"
        },
        {
          "type": "select", "id": "vertical_pos_mobile", "label": "Vertical position (mobile)",
          "options": [
            { "value": "am--position-top-mobile", "label": "Top" },
            { "value": "am--position-middle-mobile", "label": "Middle" },
            { "value": "am--position-bottom-mobile", "label": "Bottom" }
          ], "default": "am--position-top-mobile"
        },
        { "type": "range", "id": "horizontal_reposition", "label": "Horizontal reposition (desktop)", "min": -200, "max": 200, "step": 5, "unit": "%", "default": 0 },
        { "type": "range", "id": "horizontal_reposition_mobile", "label": "Horizontal reposition (mobile)", "min": -200, "max": 200, "step": 5, "unit": "%", "default": 0 },
        { "type": "checkbox", "id": "zindex", "label": "In front of content", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "AM Numbered Slideshow",
      "blocks": [
        { "type": "slide", "settings": { "title": "Bistro Style", "link_title": "Shop the Collection", "url": "#" } },
        { "type": "slide", "settings": { "title": "The world's most beautiful grill", "link_title": "Shop the Collection", "url": "#" } },
        { "type": "slide", "settings": { "title": "Seasonal collection", "link_title": "Shop the Collection", "url": "#" } }
      ]
    }
  ]
}
{% endschema %}
