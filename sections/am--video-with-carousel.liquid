{{ 'am--video-with-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'am--video-with-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign overlay_x = 'center'
  if section.settings.text_horizontal_position == 'start'
    assign overlay_x = 'flex-start'
  elsif section.settings.text_horizontal_position == 'end'
    assign overlay_x = 'flex-end'
  endif
  assign overlay_y = 'center'
  if section.settings.text_vertical_position == 'start'
    assign overlay_y = 'flex-start'
  elsif section.settings.text_vertical_position == 'end'
    assign overlay_y = 'flex-end'
  endif
  assign overlay_text_align = 'center'
  if section.settings.text_align == 'tl'
    assign overlay_text_align = 'left'
  elsif section.settings.text_align == 'tr'
    assign overlay_text_align = 'right'
  elsif section.settings.text_align == 'tj'
    assign overlay_text_align = 'justify'
  endif
  assign button_align = 'center'
  if section.settings.position == 'start'
    assign button_align = 'flex-start'
  elsif section.settings.position == 'end'
    assign button_align = 'flex-end'
  endif
  assign slider_items = section.blocks | where: 'type', 'slide'
  assign media_sizes = '(min-width: 1024px) ' | append: section.settings.media_width_desktop | append: 'vw, 90vw'
  assign slide_sizes = '(min-width: 1024px) ' | append: section.settings.slide_width_desktop | append: 'vw, 85vw'

  assign background_color = section.settings.background_color | default: 'transparent'
  assign text_color = 'inherit'
  assign heading_color = section.settings.heading_color | default: 'inherit'
  assign overlay_color = section.settings.video_text_color | default: '#ffffff'
  assign carousel_heading_color = section.settings.carousel_heading_color | default: 'inherit'
  assign slide_background = section.settings.slider_item_background_color | default: 'transparent'
  assign slide_heading_color = '#262a2b'
  assign slide_counter_color = '#ffffff'
  assign progress_color = section.settings.progress_color | default: '#000000'
  assign progress_background = section.settings.background_progress_color | default: '#fefefe'
  assign arrow_text_color = '#000000'
  assign arrow_background = 'rgba(255, 255, 255, .8)'
  assign autoplay_text_color = '#ffffff'
  assign autoplay_background = 'transparent'

  if section.settings.enable_color_scheme
    assign background_color = 'var(--color-background)'
    assign text_color = 'var(--color-foreground)'
    assign heading_color = 'var(--color-foreground-heading)'
    assign overlay_color = 'var(--color-foreground)'
    assign carousel_heading_color = 'var(--color-foreground-heading)'
    assign slide_background = 'var(--color-background)'
    assign slide_heading_color = 'var(--color-foreground-heading)'
    assign slide_counter_color = 'var(--color-foreground)'
    assign progress_color = 'var(--color-primary)'
    assign progress_background = 'var(--color-border)'
    assign arrow_text_color = 'var(--color-primary-button-text)'
    assign arrow_background = 'var(--color-primary-button-background)'
    assign autoplay_text_color = 'var(--color-primary-button-text)'
    assign autoplay_background = 'var(--color-primary-button-background)'
  endif
-%}

<am-video-with-carousel
  class="am--video-with-carousel{% if section.settings.enable_color_scheme %} color-{{ section.settings.color_scheme }}{% endif %}{% if section.settings.section_height != 'auto' %} am--has-section-ratio{% endif %}{% if section.settings.align_slider_items %} am--align-slider-items{% endif %}{% if section.settings.disable_smooth_transition %} am--disable-slide-transition{% endif %}{% unless section.settings.show_mobile %} am--hide-mobile{% endunless %}{% unless section.settings.show_tablet %} am--hide-tablet{% endunless %}{% unless section.settings.show_desktop %} am--hide-desktop{% endunless %}{% if section.settings.snow_animation %} am--has-snow{% endif %}"
  style="--am-background-color: {{ background_color }}; --am-text-color: {{ text_color }};{% if section.settings.background_image != blank %} --am-background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');{% endif %}{% if section.settings.snow_image_1 != blank %} --am-snow-1: url('{{ section.settings.snow_image_1 | image_url: width: 1600 }}');{% endif %}{% if section.settings.snow_image_2 != blank %} --am-snow-2: url('{{ section.settings.snow_image_2 | image_url: width: 1600 }}');{% endif %}{% if section.settings.snow_image_3 != blank %} --am-snow-3: url('{{ section.settings.snow_image_3 | image_url: width: 1600 }}');{% endif %} --am-heading-color: {{ heading_color }}; --am-overlay-color: {{ overlay_color }}; --am-overlay-align-x: {{ overlay_x }}; --am-overlay-align-y: {{ overlay_y }}; --am-overlay-text-align: {{ overlay_text_align }}; --am-button-align: {{ button_align }}; --am-carousel-heading-color: {{ carousel_heading_color }}; --am-slide-background: {{ slide_background }}; --am-slide-heading-color: {{ slide_heading_color }}; --am-slide-counter-color: {{ slide_counter_color }}; --am-progress-color: {{ progress_color }}; --am-progress-background: {{ progress_background }}; --am-arrow-text-color: {{ arrow_text_color }}; --am-arrow-background: {{ arrow_background }}; --am-autoplay-text-color: {{ autoplay_text_color }}; --am-autoplay-background: {{ autoplay_background }}; --am-media-width-desktop: {{ section.settings.media_width_desktop }}%; --am-slide-width-desktop: {{ section.settings.slide_width_desktop }}%; --am-content-justify-desktop: {{ section.settings.content_justify_desktop }};{% if section.settings.section_height != 'auto' %} --am-section-ratio: {{ section.settings.section_height }};{% endif %}"
  data-am-interval="{{ section.settings.carousel_timer | times: 1000 }}"
  data-am-autoplay="true"
>
  {%- if section.settings.heading != blank -%}
    <div class="am--video-with-carousel__heading-wrapper">
      <h2 class="am--video-with-carousel__heading">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="am--video-with-carousel__content">
    {%- if section.settings.video_url != blank and section.settings.replacing_image == blank -%}
      <div class="am--video-with-carousel__media">
        <div class="am--video-with-carousel__media-frame">
          <video
            class="am--video-with-carousel__video"
            data-am-video
            playsinline
            preload="metadata"
            {% if section.settings.video_loop %}loop{% endif %}
            {% if section.settings.video_poster != blank %}poster="{{ section.settings.video_poster | image_url: width: 1600 }}"{% endif %}
          >
            <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
          </video>
          <div class="am--video-with-carousel__video-controls">
            <button class="am--video-with-carousel__video-button" type="button" data-am-video-play aria-label="Play video" aria-pressed="true">
              <svg class="am--video-with-carousel__icon-play" aria-hidden="true" viewBox="0 0 20 40"><path d="M18 18.3 3.7 5.1A2 2 0 0 0 .5 6.6v26.8A2 2 0 0 0 3.7 35L18 21.7a2.3 2.3 0 0 0 0-3.4Z"/></svg>
              <svg class="am--video-with-carousel__icon-pause" aria-hidden="true" viewBox="0 0 10 12"><path d="M0 1.5a1.5 1.5 0 0 1 3 0v9a1.5 1.5 0 0 1-3 0Zm7 0a1.5 1.5 0 0 1 3 0v9a1.5 1.5 0 0 1-3 0Z"/></svg>
            </button>
            <button class="am--video-with-carousel__video-button" type="button" data-am-video-mute aria-label="Mute video" aria-pressed="false">
              <svg class="am--video-with-carousel__icon-volume" aria-hidden="true" viewBox="0 0 16 16"><path d="M1 6h3l4-4v12l-4-4H1Zm9-1.5a1 1 0 0 1 1.4 0 5 5 0 0 1 0 7 1 1 0 1 1-1.4-1.4 3 3 0 0 0 0-4.2 1 1 0 0 1 0-1.4Z"/></svg>
              <svg class="am--video-with-carousel__icon-muted" aria-hidden="true" viewBox="0 0 16 16"><path d="M1 6h3l4-4v12l-4-4H1Zm9.3-.7 1.7 1.7 1.7-1.7 1 1L13 8l1.7 1.7-1 1L12 9l-1.7 1.7-1-1L11 8 9.3 6.3Z"/></svg>
            </button>
            <input class="am--video-with-carousel__video-progress" data-am-video-progress type="range" min="0" max="100" step="0.1" value="0" aria-label="Video progress">
          </div>
          <div class="am--video-with-carousel__overlay">
            <div class="am--video-with-carousel__overlay-inner">
              {%- if section.settings.title != blank -%}<h3 class="am--video-with-carousel__media-title">{{ section.settings.title | escape }}</h3>{%- endif -%}
              {%- if section.settings.description != blank -%}<div class="am--video-with-carousel__media-description">{{ section.settings.description | escape }}</div>{%- endif -%}
              {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
                <div class="am--video-with-carousel__button-wrapper">
                  <a class="am--video-with-carousel__button button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- elsif section.settings.replacing_image != blank -%}
      <div class="am--video-with-carousel__media">
        <div class="am--video-with-carousel__replacement">
          {%- capture replacement_image -%}
            {{ section.settings.replacing_image | image_url: width: 1800 | image_tag: widths: '375, 550, 750, 1100, 1500, 1800', sizes: media_sizes, loading: 'lazy', class: 'am--video-with-carousel__replacement-image' }}
          {%- endcapture -%}
          {%- if section.settings.replacing_image_url != blank -%}
            <a href="{{ section.settings.replacing_image_url }}" aria-label="{{ section.settings.replacing_image.alt | default: section.settings.title | escape }}">{{ replacement_image }}</a>
          {%- else -%}
            {{ replacement_image }}
          {%- endif -%}
          <div class="am--video-with-carousel__overlay">
            <div class="am--video-with-carousel__overlay-inner">
              {%- if section.settings.title != blank -%}<h3 class="am--video-with-carousel__media-title">{{ section.settings.title | escape }}</h3>{%- endif -%}
              {%- if section.settings.description != blank -%}<div class="am--video-with-carousel__media-description">{{ section.settings.description | escape }}</div>{%- endif -%}
              {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
                <div class="am--video-with-carousel__button-wrapper">
                  <a class="am--video-with-carousel__button button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

    <div class="am--video-with-carousel__carousel" aria-roledescription="carousel" aria-label="{{ section.settings.carousel_heading | default: 'Carousel' | escape }}">
      {%- if section.settings.carousel_heading != blank -%}
        <h2 class="am--video-with-carousel__carousel-heading">{{ section.settings.carousel_heading | escape }}</h2>
      {%- endif -%}
      {%- if slider_items.size > 0 -%}
        <div class="am--video-with-carousel__carousel-viewport">
          <div class="am--video-with-carousel__slides" data-am-slides>
            <ul class="am--video-with-carousel__slide-list">
            {%- for block in slider_items -%}
              <li
                class="am--video-with-carousel__slide{% if forloop.first %} am--is-active{% endif %}"
                data-am-slide
                aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                aria-label="{{ forloop.index }} of {{ forloop.length }}"
                {{ block.shopify_attributes }}
              >
                <div class="am--video-with-carousel__slide-image">
                  {%- if block.settings.media_type == 'video' and block.settings.video != blank -%}
                    <div class="am--video-with-carousel__slide-video-wrapper" aria-hidden="true">
                      {{
                        block.settings.video
                        | video_tag:
                          image_size: '1400x',
                          autoplay: false,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'none',
                          class: 'am--video-with-carousel__slide-video'
                      }}
                    </div>
                  {%- elsif block.settings.media_type != 'video' and block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1400 | image_tag: widths: '300, 450, 600, 900, 1200, 1400', sizes: slide_sizes, loading: 'lazy' }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'am--video-with-carousel__placeholder' }}
                  {%- endif -%}
                  {%- if section.settings.show_slider_controls -%}
                    <div class="am--video-with-carousel__progress-track" aria-hidden="true"><div class="am--video-with-carousel__progress" data-am-progress></div></div>
                  {%- endif -%}
                </div>
                <div class="am--video-with-carousel__slide-copy">
                  {%- if block.settings.title != blank -%}<h3 class="am--video-with-carousel__slide-title">{{ block.settings.title | escape }}</h3>{%- endif -%}
                  {%- if block.settings.link_title != blank and block.settings.url != blank -%}<a class="am--video-with-carousel__slide-link button" href="{{ block.settings.url }}">{{ block.settings.link_title | escape }}</a>{%- endif -%}
                  <span class="am--video-with-carousel__counter" aria-hidden="true">{{ forloop.index }} | {{ forloop.length }}</span>
                </div>
              </li>
            {%- endfor -%}
            </ul>
            {%- if slider_items.size > 1 and section.settings.show_slider_controls -%}
              <button class="am--video-with-carousel__autoplay-button" type="button" data-am-carousel-toggle aria-label="Pause carousel" aria-pressed="false">
                <svg class="am--video-with-carousel__icon-play" aria-hidden="true" viewBox="0 0 20 40"><path d="M18 18.3 3.7 5.1A2 2 0 0 0 .5 6.6v26.8A2 2 0 0 0 3.7 35L18 21.7a2.3 2.3 0 0 0 0-3.4Z"/></svg>
                <svg class="am--video-with-carousel__icon-pause" aria-hidden="true" viewBox="0 0 10 12"><path d="M0 1.5a1.5 1.5 0 0 1 3 0v9a1.5 1.5 0 0 1-3 0Zm7 0a1.5 1.5 0 0 1 3 0v9a1.5 1.5 0 0 1-3 0Z"/></svg>
              </button>
              <button class="am--video-with-carousel__arrow am--video-with-carousel__arrow--previous" type="button" data-am-previous aria-label="Previous slide"><svg aria-hidden="true" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.5" d="m10.5 2-6 6 6 6"/></svg></button>
              <button class="am--video-with-carousel__arrow am--video-with-carousel__arrow--next" type="button" data-am-next aria-label="Next slide"><svg aria-hidden="true" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.5" d="m5.5 2 6 6-6 6"/></svg></button>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- assign illustrations = section.blocks | where: 'type', 'illustration' -%}
  {%- for block in illustrations -%}
    {%- if block.settings.image != blank -%}
      <div
        class="am--video-with-carousel__illustration {{ block.settings.horizontal_pos }} {{ block.settings.horizontal_pos_mobile }} {{ block.settings.vertical_pos }} {{ block.settings.vertical_pos_mobile }}{% if block.settings.image_mobile != blank %} am--has-mobile-image{% endif %}{% if block.settings.zindex %} am--position-front{% endif %}"
        style="--am-reposition-desktop: {{ block.settings.horizontal_reposition }}%; --am-reposition-mobile: {{ block.settings.horizontal_reposition_mobile }}%; --am-illustration-width-desktop: {{ block.settings.image.width }}px; --am-illustration-height-desktop: {{ block.settings.image.height }}px;{% if block.settings.image_mobile != blank %} --am-illustration-width-mobile: {{ block.settings.image_mobile.width }}px; --am-illustration-height-mobile: {{ block.settings.image_mobile.height }}px;{% else %} --am-illustration-width-mobile: {{ block.settings.image.width }}px; --am-illustration-height-mobile: {{ block.settings.image.height }}px;{% endif %}"
        data-am-illustration
        {{ block.shopify_attributes }}
      >
        {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', class: 'am--video-with-carousel__illustration-desktop' }}
        {%- if block.settings.image_mobile != blank -%}{{ block.settings.image_mobile | image_url: width: block.settings.image_mobile.width | image_tag: loading: 'lazy', class: 'am--video-with-carousel__illustration-mobile' }}{%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
</am-video-with-carousel>

{% schema %}
{
  "name": "AM Video + Carrusel",
  "tag": "section",
  "class": "am--shopify-section-video-carousel",
  "settings": [
    { "type": "header", "content": "Configuración general" },
    { "type": "checkbox", "id": "snow_animation", "label": "Activar animación de nieve", "default": false },
    { "type": "image_picker", "id": "snow_image_1", "label": "Capa de nieve 1" },
    { "type": "image_picker", "id": "snow_image_2", "label": "Capa de nieve 2" },
    { "type": "image_picker", "id": "snow_image_3", "label": "Capa de nieve 3" },
    { "type": "text", "id": "heading", "label": "Título de la sección", "default": "Section title" },
    { "type": "checkbox", "id": "enable_color_scheme", "label": "Usar esquema de colores del tema", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1", "visible_if": "{{ section.settings.enable_color_scheme }}" },
    { "type": "color", "id": "heading_color", "label": "Color del encabezado", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "image_picker", "id": "background_image", "label": "Imagen de fondo" },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "header", "content": "Configuración del video" },
    { "type": "image_picker", "id": "video_poster", "label": "Imagen de portada del video" },
    { "type": "text", "id": "video_url", "label": "URL del video", "info": "URL directa a un archivo de video MP4." },
    { "type": "checkbox", "id": "video_loop", "label": "Repetir video", "default": true },
    { "type": "header", "content": "Reemplazar video por imagen" },
    { "type": "image_picker", "id": "replacing_image", "label": "Imagen de reemplazo", "info": "Al seleccionarla, esta imagen reemplaza el video." },
    { "type": "url", "id": "replacing_image_url", "label": "Enlace de la imagen" },
    { "type": "header", "content": "Configuración del contenido" },
    { "type": "text", "id": "title", "label": "Título", "default": "Title" },
    { "type": "textarea", "id": "description", "label": "Descripción", "default": "Description" },
    { "type": "text", "id": "button_label", "label": "Etiqueta del botón", "default": "Button" },
    {
      "type": "select", "id": "text_horizontal_position", "label": "Posición horizontal del texto",
      "options": [ { "value": "start", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "end", "label": "Derecha" } ], "default": "center"
    },
    {
      "type": "select", "id": "text_vertical_position", "label": "Posición vertical del texto",
      "options": [ { "value": "start", "label": "Arriba" }, { "value": "center", "label": "Centro" }, { "value": "end", "label": "Abajo" } ], "default": "end"
    },
    {
      "type": "select", "id": "text_align", "label": "Alineación del texto",
      "options": [ { "value": "tl", "label": "Izquierda" }, { "value": "tc", "label": "Centro" }, { "value": "tr", "label": "Derecha" }, { "value": "tj", "label": "Justificado" } ], "default": "tc"
    },
    {
      "type": "select", "id": "position", "label": "Posición del botón",
      "options": [ { "value": "start", "label": "Inicio" }, { "value": "center", "label": "Centro" }, { "value": "end", "label": "Final" } ], "default": "start"
    },
    { "type": "checkbox", "id": "plain-text-btn", "label": "Botón como texto simple", "default": false },
    { "type": "checkbox", "id": "underline", "label": "Subrayar botón", "default": false },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "color", "id": "video_text_color", "label": "Color del texto", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "color", "id": "btn_color", "label": "Color de fondo del botón", "default": "#000000", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "color", "id": "btn_text_color", "label": "Color del texto del botón", "default": "#ffffff", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "color", "id": "button_border_color", "label": "Color del borde del botón", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "header", "content": "Contenido del carrusel" },
    { "type": "text", "id": "carousel_heading", "label": "Encabezado del carrusel", "default": "Carousel heading" },
    { "type": "color", "id": "carousel_heading_color", "label": "Color del encabezado del carrusel", "default": "#000000", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "checkbox", "id": "show_slider_controls", "label": "Mostrar controles del carrusel", "default": true },
    { "type": "checkbox", "id": "align_slider_items", "label": "Alinear las diapositivas en la misma posición", "default": false },
    { "type": "checkbox", "id": "disable_smooth_transition", "label": "Desactivar transición suave entre diapositivas", "default": false },
    { "type": "color", "id": "slider_item_background_color", "label": "Color de fondo de las diapositivas", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
    { "type": "checkbox", "id": "show_desktop", "label": "Mostrar en escritorio", "default": true },
    { "type": "checkbox", "id": "show_tablet", "label": "Mostrar en tablet", "default": true },
    { "type": "checkbox", "id": "show_mobile", "label": "Mostrar en móvil", "default": true },
    {
      "type": "select",
      "id": "section_height",
      "label": "Altura de la sección (escritorio)",
      "options": [
        { "value": "auto", "label": "Automática" },
        { "value": "21 / 9", "label": "Pequeña" },
        { "value": "16 / 9", "label": "Mediana" },
        { "value": "4 / 3", "label": "Grande" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "Disposición en escritorio" },
    { "type": "range", "id": "media_width_desktop", "label": "Ancho del medio", "min": 20, "max": 80, "step": 1, "default": 40, "unit": "%" },
    { "type": "range", "id": "slide_width_desktop", "label": "Ancho de las diapositivas", "min": 20, "max": 80, "step": 1, "default": 38, "unit": "%" },
    {
      "type": "select",
      "id": "content_justify_desktop",
      "label": "Distribución del contenido",
      "options": [
        { "value": "flex-start", "label": "Inicio" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Final" },
        { "value": "space-between", "label": "Espacio entre elementos" },
        { "value": "space-around", "label": "Espacio alrededor" },
        { "value": "space-evenly", "label": "Espacio uniforme" }
      ],
      "default": "space-around"
    },
    { "type": "range", "id": "carousel_timer", "label": "Duración de cada diapositiva", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "color", "id": "progress_color", "label": "Color del progreso", "default": "#000000", "visible_if": "{{ section.settings.enable_color_scheme == false }}" },
