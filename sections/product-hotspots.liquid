

{{ 'product-hotspot.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'product-hotspot.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'buy-buttons-styles' %}
{% render 'product-badges-styles' %}

{% liquid
  assign base_image = section.settings.image | default: section.settings.image_mobile
  assign overlay_content_alignment = section.settings.overlay_content_alignment | default: 'auto'
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index <= 3
    assign image_loading = 'eager'
  endif
  if section.index == 1
    assign image_priority = 'high'
  endif
%}

{% capture editorial_text %}
  {% if section.settings.overlay_heading != blank %}
    <h2 class="hotspots-editorial__heading">{{ section.settings.overlay_heading }}</h2>
  {% endif %}
  {% if section.settings.overlay_text != blank %}
    <div class="hotspots-editorial__text rte">{{ section.settings.overlay_text }}</div>
  {% endif %}
{% endcapture %}
{% assign editorial_text = editorial_text | strip %}

{% capture editorial_button %}
  {% if section.settings.overlay_button_label != blank %}
    <a
      class="button"
      {% if section.settings.overlay_button_link != blank %}
        href="{{ section.settings.overlay_button_link }}"
      {% else %}
        role="link"
        aria-disabled="true"
      {% endif %}
    >
      {{ section.settings.overlay_button_label | escape }}
    </a>
  {% endif %}
{% endcapture %}
{% assign editorial_button = editorial_button | strip %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    section-product-hotspots
    {% if section.settings.animate_hotspots %}section-product-hotspots--animate-hotspots{% endif %}
    {% if section.settings.hide_hotspots_mobile %}section-product-hotspots--hide-hotspots-mobile{% endif %}
    color-{{ section.settings.color_scheme }}
    spacing-style
    gap-style
  "
  data-testid="product-hotspots"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: 28 %}
    {% if section.settings.section_height != 'auto' %}
      --ratio: {{ section.settings.section_height }};
    {% elsif base_image != blank %}
      --ratio: {{ base_image.aspect_ratio }};
      {% if section.settings.image_mobile != blank %}
        --ratio-mobile: {{ section.settings.image_mobile.aspect_ratio }};
      {% endif %}
    {% endif %}
    --hotspots-image-position: {{ base_image.presentation.focal_point | default: 'center' }};
    --hotspots-image-position-mobile: {{ section.settings.image_mobile.presentation.focal_point | default: base_image.presentation.focal_point | default: 'center' }};
    --product-title-gap: {{ section.settings.product_title_gap }}px;
    --hotspot-size: 36px;
    --minimum-width-dialog: 260px;
    --maximum-width-dialog: 330px;
    --width-product-image-dialog: 110px;
  "
>
  <div class="section-product-hotspots__wrapper">
    <div class="section-product-hotspots__header">
      {% content_for 'block', type: 'text', id: 'heading' %}
    </div>

    {% if section.settings.content_above_image and editorial_text != blank %}
      <div class="hotspots-editorial hotspots-editorial--outside hotspots-editorial--{{ section.settings.overlay_content_position }}">
        <div class="hotspots-editorial__content hotspots-editorial__content--{{ overlay_content_alignment }}">
          {{ editorial_text }}
        </div>
      </div>
    {% endif %}

    <product-hotspots
      class="section-product-hotspots__interactive"
      data-hide-inactive-desktop
      data-mobile-preview-quick-buy="{{ section.settings.mobile_preview_quick_buy }}"
    >
      <div class="section-product-hotspots__content" id="HotspotsMedia-{{ section.id }}">
        {% if section.settings.toggle_overlay %}
          {% render 'overlay', settings: section.settings, layer: '1' %}
        {% endif %}

        {% if base_image != blank %}
          <picture>
            {% if section.settings.image != blank and section.settings.image_mobile != blank %}
              <source
                media="(max-width: 749px)"
                srcset="{{ section.settings.image_mobile | image_url: width: 375 }} 375w, {{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w, {{ section.settings.image_mobile | image_url: width: 1500 }} 1500w"
                sizes="100vw"
                width="{{ section.settings.image_mobile.width }}"
                height="{{ section.settings.image_mobile.height }}"
              >
            {% endif %}
            {{ base_image | image_url: width: 3000 | image_tag: class: 'hotspots__background-image hotspots__background-image--base', widths: '375, 750, 1100, 1500, 2000, 2500, 3000', sizes: '100vw', loading: image_loading, fetchpriority: image_priority, style: 'object-position: var(--hotspots-image-position);' }}
          </picture>
        {% else %}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'hotspots__background-image hotspots__background-image--base' }}
        {% endif %}

        <img class="hotspots__background-image hotspots__background-image--hover" alt="" aria-hidden="true" width="2000" height="2000" data-hotspot-hover-image>

        {% liquid
          assign show_overlay_text = false
          assign show_overlay_button = false
          unless section.settings.content_above_image
            if editorial_text != blank
              assign show_overlay_text = true
            endif
          endunless
          unless section.settings.button_below_image
            if editorial_button != blank
              assign show_overlay_button = true
            endif
          endunless
        %}
        {% if show_overlay_text or show_overlay_button %}
          <div class="hotspots-editorial hotspots-editorial--{{ section.settings.overlay_content_position }}">
            <div class="hotspots-editorial__content hotspots-editorial__content--{{ overlay_content_alignment }}">
              {% if show_overlay_text %}
                {{ editorial_text }}
              {% endif %}
              {% if show_overlay_button %}
                {{ editorial_button }}
              {% endif %}
            </div>
          </div>
        {% endif %}

        <div class="hotspots-container">
          {% content_for 'blocks' %}
        </div>
        <div
          id="HotspotsQuickBuy-{{ section.id }}"
          class="hotspots-mobile-quick-buy"
          data-hotspot-mobile-quick-buy-panel
          aria-live="polite"
          aria-hidden="true"
          inert
          hidden
        ></div>
      </div>

      <div class="hotspots-mobile-buttons" data-hotspot-mobile-buttons hidden></div>
    </product-hotspots>

    {% if section.settings.button_below_image and editorial_button != blank %}
      <div class="hotspots-editorial hotspots-editorial--outside hotspots-editorial--{{ section.settings.overlay_content_position }}">
        <div class="hotspots-editorial__content hotspots-editorial__content--{{ overlay_content_alignment }}">
          {{ editorial_button }}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* Section layout */
  .section-product-hotspots {
    position: relative;
  }

  .section-product-hotspots__wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
  }

  .section-product-hotspots__interactive {
    display: block;
    min-width: 0;
  }

  /* Image container */
  .section-product-hotspots__content {
    display: block;
    position: relative;
    aspect-ratio: var(--ratio, 21 / 9);
    overflow: hidden;
    isolation: isolate;
  }

  /* Shared hotspot and hover-image styles are loaded from product-hotspot.css. */

  .hotspots-editorial {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    padding: clamp(var(--padding-md), 5vw, var(--padding-3xl));
    pointer-events: none;
  }

  .hotspots-editorial--top-left { align-items: flex-start; justify-content: flex-start; text-align: left; }
  .hotspots-editorial--top-center { align-items: flex-start; justify-content: center; text-align: center; }
  .hotspots-editorial--top-right { align-items: flex-start; justify-content: flex-end; text-align: right; }
  .hotspots-editorial--center-left { align-items: center; justify-content: flex-start; text-align: left; }
  .hotspots-editorial--center { align-items: center; justify-content: center; text-align: center; }
  .hotspots-editorial--center-right { align-items: center; justify-content: flex-end; text-align: right; }
  .hotspots-editorial--bottom-left { align-items: flex-end; justify-content: flex-start; text-align: left; }
  .hotspots-editorial--bottom-center { align-items: flex-end; justify-content: center; text-align: center; }
  .hotspots-editorial--bottom-right { align-items: flex-end; justify-content: flex-end; text-align: right; }

  .hotspots-editorial__content {
    max-width: min(34rem, 100%);
    color: var(--color-foreground);
    text-shadow: 0 1px 18px rgb(0 0 0 / 0.3);
  }

  .hotspots-editorial__content--start { text-align: start; }
  .hotspots-editorial__content--center { text-align: center; }
  .hotspots-editorial__content--end { text-align: end; }

  .hotspots-editorial__content > * { margin: 0; }
  .hotspots-editorial__content > * + * { margin-block-start: var(--gap-md); }
  .hotspots-editorial__content .button { pointer-events: auto; text-shadow: none; }

  .hotspots-editorial:is(.hotspots-editorial--top-left, .hotspots-editorial--center-left, .hotspots-editorial--bottom-left)
    .hotspots-editorial__content--auto .button,
  .hotspots-editorial__content--start .button {
    margin-inline: 0 auto;
  }

  .hotspots-editorial:is(.hotspots-editorial--top-center, .hotspots-editorial--center, .hotspots-editorial--bottom-center)
    .hotspots-editorial__content--auto .button,
  .hotspots-editorial__content--center .button {
    margin-inline: auto;
  }

  .hotspots-editorial:is(.hotspots-editorial--top-right, .hotspots-editorial--center-right, .hotspots-editorial--bottom-right)
    .hotspots-editorial__content--auto .button,
  .hotspots-editorial__content--end .button {
    margin-inline: auto 0;
  }

  .hotspots-editorial--outside {
    position: static;
    padding: var(--padding-lg) 0;
  }

  .hotspots-editorial--outside .hotspots-editorial__content {
    text-shadow: none;
  }

  .hotspots-mobile-buttons {
    display: none;
  }

  .hotspots-mobile-quick-buy {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .section-product-hotspots__content {
      --hotspots-image-position: var(--hotspots-image-position-mobile);
      aspect-ratio: var(--ratio-mobile, var(--ratio, 21 / 9));
    }

    .section-product-hotspots--hide-hotspots-mobile .hotspot:not([data-editor-selected]) {
      display: none;
    }

    .section-product-hotspots__interactive[data-mobile-preview-active] .hotspots-container {
      visibility: hidden;
    }

    .hotspots-mobile-buttons:not([hidden]) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap-sm);
      padding-block-start: var(--padding-lg);
    }

    .hotspots-mobile-buttons__button {
      width: 100%;
      min-width: 0;
      min-height: 44px;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .hotspots-mobile-buttons__button[aria-pressed='true'] {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }

    .hotspots-mobile-quick-buy:not([hidden]) {
      position: absolute;
      inset: 0;
      z-index: 4;
      display: block;
      opacity: 0;
      pointer-events: none;
      transition: opacity 200ms ease;
    }

    .hotspots-mobile-quick-buy.is-active {
      opacity: 1;
    }

    .hotspots-mobile-quick-buy__inner {
      position: absolute;
      left: var(--mobile-quick-buy-left, 50%);
      top: var(--mobile-quick-buy-top, 85%);
      display: flex;
      align-items: center;
      gap: 8px;
      width: max-content;
      max-width: calc(100% - 24px);
      transform: translateY(calc(-50% + var(--mobile-quick-buy-enter-offset, -8px)));
      transition: transform 200ms ease;
    }

    .hotspots-mobile-quick-buy.is-active .hotspots-mobile-quick-buy__inner {
      transform: translateY(-50%);
    }

    .hotspots-mobile-quick-buy__inner > .button {
      width: fit-content;
      max-width: 100%;
      min-width: 0;
      min-height: 44px;
      white-space: normal;
      overflow-wrap: anywhere;
      pointer-events: auto;
    }

    .hotspots-mobile-quick-buy__inner > .hotspots-mobile-quick-buy__close {
      display: inline-flex;
      flex: 0 0 44px;
      align-items: center;
      justify-content: center;
      width: 44px;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hotspots-mobile-quick-buy:not([hidden]),
    .hotspots-mobile-quick-buy__inner {
      transition: none;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_hotspots",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_hotspot-product"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.hotspots_image_mobile"
    },
    {
      "type": "header",
      "content": "t:settings.text_on_images"
    },
    {
      "type": "inline_richtext",
      "id": "overlay_heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "overlay_text",
      "label": "t:settings.text"
    },
    {
      "type": "checkbox",
      "id": "content_above_image",
      "label": "t:settings.hotspots_content_above_image",
      "default": false
    },
    {
      "type": "text",
      "id": "overlay_button_label",
      "label": "t:settings.button_label"
    },
    {
      "type": "url",
      "id": "overlay_button_link",
      "label": "t:settings.button_link"
    },
    {
      "type": "checkbox",
      "id": "button_below_image",
      "label": "t:settings.hotspots_button_below_image",
      "default": false
    },
    {
      "type": "select",
      "id": "overlay_content_position",
      "label": "t:settings.content_position",
      "options": [
        { "value": "top-left", "label": "t:options.top_left" },
        { "value": "top-center", "label": "t:options.top" },
        { "value": "top-right", "label": "t:options.top_right" },
        { "value": "center-left", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "center-right", "label": "t:options.right" },
        { "value": "bottom-left", "label": "t:options.bottom_left" },
        { "value": "bottom-center", "label": "t:options.bottom" },
        { "value": "bottom-right", "label": "t:options.bottom_right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "overlay_content_alignment",
      "label": "t:settings.content_alignment",
      "options": [
        { "value": "auto", "label": "t:options.auto" },
        { "value": "start", "label": "t:options.start" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.end" }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.media_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "21 / 9",
          "label": "t:options.small"
        },
        {
          "value": "16 / 9",
          "label": "t:options.medium"
        },
        {
          "value": "4 / 3",
          "label": "t:options.large"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "t:content.interaction"
    },
    {
      "type": "checkbox",
      "id": "animate_hotspots",
      "label": "t:settings.hotspots_animate",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_hotspots_mobile",
      "label": "t:settings.hotspots_hide_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_preview_quick_buy",
      "label": "t:settings.hotspots_mobile_preview_quick_buy",
      "info": "t:info.hotspots_mobile_preview_quick_buy",
      "default": false
    },
    {
      "type": "select",
      "id": "desktop_interaction_mode",
      "label": "t:settings.desktop_interaction_mode",
      "options": [
        {
          "value": "hover-preview-click-quick-buy",
          "label": "t:options.hover_preview_click_quick_buy"
        },
        {
          "value": "click-preview",
          "label": "t:options.click_preview"
        },
        {
          "value": "click-quick-buy",
          "label": "t:options.click_quick_buy"
        }
      ],
      "default": "hover-preview-click-quick-buy"
    },
    {
      "type": "text",
      "id": "quick_buy_hover_label",
      "label": "t:settings.quick_buy_hover_label",
      "default": "VER MÁS",
      "visible_if": "{{ section.settings.desktop_interaction_mode == 'click-quick-buy' }}"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "t:settings.hotspot_color",
      "default": "#FFFFFF57",
      "alpha": true
    },
    {
      "type": "color",
      "id": "bullseye_color",
      "label": "t:settings.bullseye_color",
      "default": "#ffffff",
      "alpha": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.popover"
    },
    {
      "type": "range",
      "id": "product_title_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "product_title_preset",
      "label": "t:settings.product_title_typography",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "select",
      "id": "product_price_preset",
      "label": "t:settings.product_price_typography",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.product_hotspots",
      "category": "t:categories.products",
      "settings": {
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "product_title_gap": 8,
        "padding-block-start": 40,
        "padding-block-end": 40
      },
      "blocks": {
        "heading": {
          "type": "text",
          "name": "t:names.heading",
          "static": true,
          "settings": {
            "text": "t:text_defaults.shop_the_look",
            "type_preset": "h4"
          }
        },
        "hotspot-1": {
          "type": "_hotspot-product",
          "settings": {
            "x-position": 40,
            "y-position": 40
          }
        },
        "hotspot-2": {
          "type": "_hotspot-product",
          "settings": {
            "x-position": 60,
            "y-position": 60
          }
        }
      },
      "block_order": ["hotspot-1", "hotspot-2"]
    }
  ]
}
{% endschema %}
