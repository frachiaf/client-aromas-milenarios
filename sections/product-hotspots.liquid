

{{ 'product-hotspot.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'product-hotspot.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'buy-buttons-styles' %}
{% render 'product-badges-styles' %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    section-product-hotspots
    color-{{ section.settings.color_scheme }}
    spacing-style
    gap-style
  "
  data-testid="product-hotspots"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: 28 %}
    {% if section.settings.section_height != 'auto' %}
      --ratio: {{ section.settings.section_height }};
    {% elsif section.settings.image != blank %}
      --ratio: {{ section.settings.image.aspect_ratio }};
    {% endif %}
    --product-title-gap: {{ section.settings.product_title_gap }}px;
    --hotspot-size: 36px;
    --minimum-width-dialog: 260px;
    --maximum-width-dialog: 330px;
    --width-product-image-dialog: 110px;
  "
>
  <div class="section-product-hotspots__wrapper">
    <div class="section-product-hotspots__header">
      {% content_for 'block', type: 'text', id: 'heading' %}
    </div>

    <product-hotspots class="section-product-hotspots__content">
      {% if section.settings.toggle_overlay %}
        {% render 'overlay', settings: section.settings, layer: '1' %}
      {% endif %}

      {% if section.settings.image != blank %}
        {% render 'image', image: section.settings.image, class: 'hotspots__background-image hotspots__background-image--base' %}
      {% else %}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'hotspots__background-image hotspots__background-image--base' }}
      {% endif %}

      <img class="hotspots__background-image hotspots__background-image--hover" alt="" aria-hidden="true" width="2000" height="2000" data-hotspot-hover-image>

      {% if section.settings.overlay_heading != blank
        or section.settings.overlay_text != blank
        or section.settings.overlay_button_label != blank
      %}
        {% assign overlay_content_alignment = section.settings.overlay_content_alignment | default: 'auto' %}
        <div class="hotspots-editorial hotspots-editorial--{{ section.settings.overlay_content_position }}">
          <div class="hotspots-editorial__content hotspots-editorial__content--{{ overlay_content_alignment }}">
            {% if section.settings.overlay_heading != blank %}
              <h2 class="hotspots-editorial__heading">{{ section.settings.overlay_heading }}</h2>
            {% endif %}
            {% if section.settings.overlay_text != blank %}
              <div class="hotspots-editorial__text rte">{{ section.settings.overlay_text }}</div>
            {% endif %}
            {% if section.settings.overlay_button_label != blank %}
              <a
                class="button"
                {% if section.settings.overlay_button_link != blank %}
                  href="{{ section.settings.overlay_button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.overlay_button_label }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="hotspots-container">
        {% content_for 'blocks' %}
      </div>
    </product-hotspots>
  </div>
</div>

{% stylesheet %}
  /* Section layout */
  .section-product-hotspots {
    position: relative;
  }

  .section-product-hotspots__wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
  }

  /* Image container */
  .section-product-hotspots__content {
    display: block;
    position: relative;
    aspect-ratio: var(--ratio, 21 / 9);
    overflow: hidden;
    isolation: isolate;
  }

  /* Shared hotspot and hover-image styles are loaded from product-hotspot.css. */

  .hotspots-editorial {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    padding: clamp(var(--padding-md), 5vw, var(--padding-3xl));
    pointer-events: none;
  }

  .hotspots-editorial--top-left { align-items: flex-start; justify-content: flex-start; text-align: left; }
  .hotspots-editorial--top-center { align-items: flex-start; justify-content: center; text-align: center; }
  .hotspots-editorial--top-right { align-items: flex-start; justify-content: flex-end; text-align: right; }
  .hotspots-editorial--center-left { align-items: center; justify-content: flex-start; text-align: left; }
  .hotspots-editorial--center { align-items: center; justify-content: center; text-align: center; }
  .hotspots-editorial--center-right { align-items: center; justify-content: flex-end; text-align: right; }
  .hotspots-editorial--bottom-left { align-items: flex-end; justify-content: flex-start; text-align: left; }
  .hotspots-editorial--bottom-center { align-items: flex-end; justify-content: center; text-align: center; }
  .hotspots-editorial--bottom-right { align-items: flex-end; justify-content: flex-end; text-align: right; }

  .hotspots-editorial__content {
    max-width: min(34rem, 100%);
    color: var(--color-foreground);
    text-shadow: 0 1px 18px rgb(0 0 0 / 0.3);
  }

  .hotspots-editorial__content--start { text-align: start; }
  .hotspots-editorial__content--center { text-align: center; }
  .hotspots-editorial__content--end { text-align: end; }

  .hotspots-editorial__content > * { margin: 0; }
  .hotspots-editorial__content > * + * { margin-block-start: var(--gap-md); }
  .hotspots-editorial__content .button { pointer-events: auto; text-shadow: none; }

  .hotspots-editorial:is(.hotspots-editorial--top-left, .hotspots-editorial--center-left, .hotspots-editorial--bottom-left)
    .hotspots-editorial__content--auto .button,
  .hotspots-editorial__content--start .button {
    margin-inline: 0 auto;
  }

  .hotspots-editorial:is(.hotspots-editorial--top-center, .hotspots-editorial--center, .hotspots-editorial--bottom-center)
    .hotspots-editorial__content--auto .button,
  .hotspots-editorial__content--center .button {
    margin-inline: auto;
  }

  .hotspots-editorial:is(.hotspots-editorial--top-right, .hotspots-editorial--center-right, .hotspots-editorial--bottom-right)
    .hotspots-editorial__content--auto .button,
  .hotspots-editorial__content--end .button {
    margin-inline: auto 0;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_hotspots",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_hotspot-product"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "header",
      "content": "t:settings.text_on_images"
    },
    {
      "type": "inline_richtext",
      "id": "overlay_heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "overlay_text",
      "label": "t:settings.text"
    },
    {
      "type": "text",
      "id": "overlay_button_label",
      "label": "t:settings.button_label"
    },
    {
      "type": "url",
      "id": "overlay_button_link",
      "label": "t:settings.button_link"
    },
    {
      "type": "select",
      "id": "overlay_content_position",
      "label": "t:settings.content_position",
      "options": [
        { "value": "top-left", "label": "t:options.top_left" },
        { "value": "top-center", "label": "t:options.top" },
        { "value": "top-right", "label": "t:options.top_right" },
        { "value": "center-left", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "center-right", "label": "t:options.right" },
        { "value": "bottom-left", "label": "t:options.bottom_left" },
        { "value": "bottom-center", "label": "t:options.bottom" },
        { "value": "bottom-right", "label": "t:options.bottom_right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "overlay_content_alignment",
      "label": "t:settings.content_alignment",
      "options": [
        { "value": "auto", "label": "t:options.auto" },
        { "value": "start", "label": "t:options.start" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.end" }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.media_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "21 / 9",
          "label": "t:options.small"
        },
        {
          "value": "16 / 9",
          "label": "t:options.medium"
        },
        {
          "value": "4 / 3",
          "label": "t:options.large"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "t:content.interaction"
    },
    {
      "type": "select",
      "id": "desktop_interaction_mode",
      "label": "t:settings.desktop_interaction_mode",
      "options": [
        {
          "value": "hover-preview-click-quick-buy",
          "label": "t:options.hover_preview_click_quick_buy"
        },
        {
          "value": "click-preview",
          "label": "t:options.click_preview"
        },
        {
          "value": "click-quick-buy",
          "label": "t:options.click_quick_buy"
        }
      ],
      "default": "hover-preview-click-quick-buy"
    },
    {
      "type": "text",
      "id": "quick_buy_hover_label",
      "label": "t:settings.quick_buy_hover_label",
      "default": "VER MÁS",
      "visible_if": "{{ section.settings.desktop_interaction_mode == 'click-quick-buy' }}"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "t:settings.hotspot_color",
      "default": "#FFFFFF57",
      "alpha": true
    },
    {
      "type": "color",
      "id": "bullseye_color",
      "label": "t:settings.bullseye_color",
      "default": "#ffffff",
      "alpha": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.popover"
    },
    {
      "type": "range",
      "id": "product_title_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "product_title_preset",
      "label": "t:settings.product_title_typography",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "select",
      "id": "product_price_preset",
      "label": "t:settings.product_price_typography",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.product_hotspots",
      "category": "t:categories.products",
      "settings": {
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "product_title_gap": 8,
        "padding-block-start": 40,
        "padding-block-end": 40
      },
      "blocks": {
        "heading": {
          "type": "text",
          "name": "t:names.heading",
          "static": true,
          "settings": {
            "text": "t:text_defaults.shop_the_look",
            "type_preset": "h4"
          }
        },
        "hotspot-1": {
          "type": "_hotspot-product",
          "settings": {
            "x-position": 40,
            "y-position": 40
          }
        },
        "hotspot-2": {
          "type": "_hotspot-product",
          "settings": {
            "x-position": 60,
            "y-position": 60
          }
        }
      },
      "block_order": ["hotspot-1", "hotspot-2"]
    }
  ]
}
{% endschema %}
