{% doc %}
  Shared component styles for product summaries, highlights, and template benefits.
{% enddoc %}
{% stylesheet %}
  .am-pdp-copy,
  .am-pdp-highlights,
  .am-pdp-benefits {
    width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--color-foreground);
    font-family: var(--font-paragraph--family);
    font-style: var(--font-paragraph--style);
    font-weight: var(--font-paragraph--weight);
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
  }

  .am-pdp-copy p,
  .am-pdp-highlights p,
  .am-pdp-benefits p {
    margin: 0;
  }

  .am-pdp-highlights__list,
  .am-pdp-benefits__list {
    list-style: none;
    margin: 0;
  }

  .am-pdp-highlights__list {
    padding: 4px 20px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    box-shadow: 0 8px 24px rgb(var(--color-shadow-rgb) / 0.06);
  }

  .am-pdp-highlights__item,
  .am-pdp-benefits__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .am-pdp-highlights__item {
    padding-block: 14px;
  }

  .am-pdp-highlights__item + .am-pdp-highlights__item {
    border-block-start: 1px solid var(--color-border);
  }

  .am-pdp-highlights__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 21px;
    width: 21px;
    height: 21px;
    margin-block-start: 2px;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--color-primary);
  }

  .am-pdp-highlights__check svg {
    width: 12px;
    height: 12px;
  }

  .am-pdp-benefits__list {
    display: grid;
    gap: 10px;
    padding: 0;
  }

  .am-pdp-benefits__icon {
    flex: 0 0 20px;
    color: var(--color-primary);
    margin-block-start: 2px;
  }
{% endstylesheet %}
