{%- doc -%}
  Renders a product hotspot with optional preview title and link overrides.

  @param {product} product - Product associated with the hotspot.
  @param {string} instance_id - Unique ID for the hotspot and Quick Add form.
  @param {number} x_position - Horizontal position as a percentage.
  @param {number} y_position - Vertical position as a percentage.
  @param {string} hotspot_color - Background color of the hotspot trigger.
  @param {string} bullseye_color - Color of the hotspot bullseye.
  @param {string} desktop_interaction_mode - Desktop interaction behavior.
  @param {string} quick_buy_hover_label - Label revealed by direct Quick Buy mode.
  @param {string} color_scheme - Color scheme used by Quick Add controls.
  @param {string} [title_override] - Optional title shown in the preview card.
  @param {string} [url_override] - Optional destination for the preview card.
  @param {image} [hover_image] - Optional image displayed while hovering.
  @param {string} [product_title_preset] - Typography preset for the title.
  @param {string} [product_price_preset] - Typography preset for the price.
  @param {string} [shopify_attributes] - Theme Editor attributes for a standalone block.
{%- enddoc -%}

{% liquid
  assign placeholder_product_title = 'placeholders.product_title' | t
  assign hotspot_product_title = title_override | default: product.title | default: placeholder_product_title
  assign hotspot_product_url = url_override | default: product.url
  assign hotspot_dialog_id = 'HotspotDialog-' | append: section.id | append: '-' | append: instance_id
%}

{% if product != blank %}
  <product-hotspot-component
    class="hotspot"
    style="
      left: calc({{ x_position }}% - var(--button-size) / 2);
      top: calc({{ y_position }}% - var(--button-size) / 2);
      --hotspot-bg: {{ hotspot_color }};
      --hotspot-bullseye: {{ bullseye_color }};
    "
    data-product-url="{{ product.url }}"
    data-product-title="{{ hotspot_product_title | escape }}"
    data-hover-image-url="{% if hover_image != blank %}{{ hover_image | image_url: width: 2000 }}{% endif %}"
    data-desktop-interaction-mode="{{ desktop_interaction_mode | default: 'hover-preview-click-quick-buy' }}"
    data-id="{{ instance_id }}"
    {{ shopify_attributes }}
  >
    <button
      class="hotspot-trigger"
      type="button"
      aria-label="{{ 'accessibility.show_product_details' | t: product_name: hotspot_product_title }}"
      aria-controls="{{ hotspot_dialog_id }}"
      aria-expanded="false"
      aria-haspopup="dialog"
      ref="trigger"
      on:click="/handleHotspotClick"
      style="anchor-name: --hotspot-trigger-{{ instance_id }};"
    >
      {% if desktop_interaction_mode == 'click-quick-buy' %}
        <span class="hotspot-trigger__quick-buy-label" aria-hidden="true">
          <span>{{ quick_buy_hover_label | default: 'VER MÁS' | escape }}</span>
        </span>
      {% endif %}
    </button>
    <dialog
      id="{{ hotspot_dialog_id }}"
      aria-label="{{ 'accessibility.product_details' | t }}"
      class="hotspot-dialog color-{{ color_scheme }}"
      ref="dialog"
    >
      <a
        href="{{ hotspot_product_url }}"
        class="hotspot-dialog__link"
        aria-label="{{ hotspot_product_title | escape }}"
        ref="productLink"
      ></a>
      <div class="hotspot-dialog__product">
        {% if product.featured_image != blank %}
          {% render 'image', image: product.featured_image, class: 'hotspot-dialog__product-image' %}
        {% else %}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'hotspot-dialog__placeholder-product-image' }}
        {% endif %}
        <div class="hotspot-dialog__product-content">
          <div class="hotspot-dialog__product-info">
            <h2 class="hotspot-dialog__product-title {{ product_title_preset | default: 'h5' }}">
              {{ hotspot_product_title | escape }}
            </h2>
            <div class="hotspot-dialog__product-price {{ product_price_preset | default: 'h6' }}">
              {% render 'price', product_resource: product %}
            </div>
          </div>
          {% if product.available %}
            {% render 'quick-add',
              product: product,
              section_id: section.id,
              block: block,
              color_scheme: color_scheme,
              instance_id: instance_id
            %}
          {% else %}
            <div class="hotspot-dialog__sold-out-badge">
              {{ 'content.product_badge_sold_out' | t }}
            </div>
          {% endif %}
        </div>
      </div>
    </dialog>
  </product-hotspot-component>
{% elsif request.design_mode %}
  <div
    class="hotspot hotspot--editor-placeholder"
    style="
      left: calc({{ x_position }}% - var(--button-size) / 2);
      top: calc({{ y_position }}% - var(--button-size) / 2);
      --hotspot-bg: {{ hotspot_color }};
      --hotspot-bullseye: {{ bullseye_color }};
    "
    role="img"
    aria-label="{{ 'content.unavailable' | t }}"
    title="{{ 'content.unavailable' | t }}"
    {{ shopify_attributes }}
  >
    <span class="hotspot-trigger" aria-hidden="true"></span>
  </div>
{% endif %}
