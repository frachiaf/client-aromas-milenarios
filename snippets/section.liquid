{%- doc -%}
  Renders a wrapper section

  @param {section} section - The section object
  @param {string} children - The children of the section
{%- enddoc -%}

{% liquid
  assign height_property = '--section-min-height'
  if section.settings.custom_mobile_height
    assign height_property = '--section-min-height-desktop'
  endif

  if section.settings.custom_mobile_layout
    assign mobile_horizontal_alignment = section.settings.horizontal_alignment_mobile
    assign mobile_vertical_alignment = section.settings.vertical_alignment_mobile
    if section.settings.content_direction_mobile == 'column'
      assign mobile_horizontal_alignment = section.settings.horizontal_alignment_column_mobile
      assign mobile_vertical_alignment = section.settings.vertical_alignment_column_mobile
    endif
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}{% if section.settings.custom_mobile_height %} section--custom-mobile-height{% endif %}"
  data-testid="ui-test-section"

  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}

  style="
    {% if section.settings.section_height == 'custom' %}
      {{ height_property }}: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      {{ height_property }}: 100svh;
    {% elsif section.settings.section_height != '' %}
      {{ height_property }}: var(--section-height-{{ section.settings.section_height }});
    {% endif %}

    {% if section.settings.custom_mobile_height %}
      {% case section.settings.section_height_mobile %}
        {% when 'custom' %}
          --section-min-height-mobile: {{ section.settings.section_height_custom_mobile }}svh;
        {% when 'full-screen' %}
          --section-min-height-mobile: 100svh;
        {% when '' %}
          --section-min-height-mobile: 0px;
        {% else %}
          --section-min-height-mobile: var(--section-height-{{ section.settings.section_height_mobile }});
      {% endcase %}
    {% endif %}

    {% if section.settings.section_height != '' %}
     --section-preview-height: 600px;
     {% endif %}
  "
>
  <div class="custom-section-background">
    {% render 'background-media',
      background_media: section.settings.background_media,
      background_video: section.settings.video,
      background_video_position: section.settings.video_position,
      background_image: section.settings.background_image,
      background_image_mobile: section.settings.background_image_mobile,
      background_image_position: section.settings.background_image_position,
      background_image_position_mobile: section.settings.background_image_position_mobile
    %}
  </div>

  <div
    class="border-style custom-section-content"
    style="{% render 'border-override', settings: section.settings %}"
  >
    {% if section.settings.toggle_overlay %}
      {% render 'overlay', settings: section.settings, layer: '0' %}
    {% endif %}

    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        section-content-wrapper
        {% if section.settings.custom_mobile_layout %}
          section-content-wrapper--mobile-{{ section.settings.content_direction_mobile }}
        {% elsif section.settings.vertical_on_mobile %}
          mobile-column
        {% endif %}
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
        {% if section.settings.custom_mobile_layout %}
          --section-horizontal-alignment-mobile: {{ mobile_horizontal_alignment }};
          --section-vertical-alignment-mobile: {{ mobile_vertical_alignment }};
          {% render 'gap-style', value: section.settings.gap_mobile, name: 'section-gap-mobile' %}
        {% endif %}
      "
      data-testid="section-content"
    >
      {{ children }}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-wrapper {
    --section-height-offset: 0px;
  }

  .section--custom-mobile-height {
    --section-min-height: var(--section-min-height-desktop, 0px);

    @media screen and (max-width: 749px) {
      --section-min-height: var(--section-min-height-mobile);
    }
  }

  @media screen and (max-width: 749px) {
    .custom-section-content
      > .section-content-wrapper:is(.section-content-wrapper--mobile-column, .section-content-wrapper--mobile-row) {
      gap: var(--section-gap-mobile);

      > :is(.menu, .text-block, .image-block, .button, .group-block) {
        flex: 0 1 auto;
      }

      > .group-block {
        height: var(--size-style-height, auto);
      }
    }

    .custom-section-content > .section-content-wrapper.section-content-wrapper--mobile-column {
      flex-flow: column nowrap;
      align-items: var(--section-horizontal-alignment-mobile);
      justify-content: var(--section-vertical-alignment-mobile);
      height: 100%;

      > .group-block--height-fill {
        flex: 1;
      }

      > .group-block--height-custom {
        flex-basis: var(--size-style-height);
      }
    }

    .custom-section-content > .section-content-wrapper.section-content-wrapper--mobile-row {
      flex-flow: row wrap;
      align-items: var(--section-vertical-alignment-mobile);
      justify-content: var(--section-horizontal-alignment-mobile);
      height: auto;

      > .menu {
        flex: 1 1 min-content;
      }

      > .text-block {
        flex: 1 1 var(--max-width--display-tight);
      }

      > .image-block {
        flex: 1 1 var(--size-style-width-mobile-min);
      }

      > .button {
        flex: 0 0 fit-content;
      }

      > .group-block--width-fit {
        flex: 0;
      }

      > .group-block--width-fill {
        flex: 1;
      }

      > .group-block--width-custom {
        flex-basis: var(--size-style-width-mobile, var(--size-style-width));
      }

      > .group-block--height-fill {
        height: calc(var(--section-min-height, auto) - var(--section-height-offset, 0px));
      }
    }
  }

  .section[data-shopify-visual-preview] {
    min-height: var(--section-preview-height);
    padding-top: 0;
  }

  .section[data-shopify-visual-preview] .custom-section-background {
    display: none;
  }

  body:has(> #header-group > .header-section > #header-component[transparent]):not(
      :has(> #header-group > .header-section + .shopify-section)
    )
    > main
    > .section-wrapper:first-child {
    --section-height-offset: var(--header-group-height, 0);
  }

  .custom-section-background {
    grid-column: 1 / -1;
  }

  .custom-section-content {
    z-index: var(--layer-flat);
  }
{% endstylesheet %}
